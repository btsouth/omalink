#!/usr/bin/env bash

set -euo pipefail
umask 077
kdeconnect_service=org.kde.kdeconnect
original_args=("$@")

usage() {
  echo "Usage: omalink [--notify-apps \"App, Package\"] [--notify-rules JSON] [--popups on|off] <status|diagnostics|watch|media|media-action|media-volume|media-seek|ring|clipboard|text-stdin|dismiss|dismiss-all|contacts|conversations|messages|attachment|attachment-open|attachment-save|seen|mark-seen> [arguments]" >&2
  exit 2
}

# --- Phone-supplied data ----------------------------------------------------
# Every busctl call below passes -- before its positional arguments. busctl keeps
# parsing options after them, so without it a phone-supplied value such as
# "--address=tcp:host=..." would be read as an option and make the helper open a
# connection to a host the phone chose.
# Everything KDE Connect reports comes from the paired phone, so none of it is
# trusted here: a phone app picks the album art URL, the notification icon path
# and the attachment contents. A path handed to the shell's image loader has to
# be a local file KDE Connect itself wrote, or that loader would fetch remote
# URLs and decode unbounded images inside the shell process. Every check fails
# closed: art that does not qualify just leaves the placeholder icon.
# KDE Connect refuses album art payloads over 5 MiB on the wire, but it
# decompresses what it transfers, so a file on disk can be larger. Eight
# megabytes leaves room for that without letting the shell read anything huge.
album_art_max_bytes=$((8 * 1024 * 1024))
icon_max_bytes=$((1 * 1024 * 1024))
# Attachments are photos, videos and documents from the phone: a cap small
# enough to reject a real video would be a bug, so this only refuses the absurd.
attachment_max_bytes=$((2 * 1024 * 1024 * 1024))
# Text and thumbnails come from the phone too, so their lengths are bounded
# before anything is copied or laid out.
title_max_chars=1024
body_max_chars=8192
preview_max_chars=1024
name_max_chars=256
id_max_chars=128
media_max_chars=256
players_max=20
thumbnail_max_chars=262144
attachments_per_message=10
contacts_max=2000
capture_max_bytes=$((16 * 1024 * 1024))
# D-Bus responses are also phone-influenced, so no direct call is slurped
# without the same ceiling. head stops the reader; SIGPIPE stops the producer.
dbus_bounded() {
  local timeout_interval="$1"
  shift
  { timeout --kill-after=1s "$timeout_interval" "$@" 2>/dev/null || true; } \
    | head -c "$capture_max_bytes" || true
}
# How much of a phone's notification list is read per refresh. Each notification
# costs several D-Bus reads, and the count is entirely the phone's to choose, so
# an app posting thousands of them must not be able to stall the bar.
notifications_read_max=100
notifications_max=25
# Per-app rules arrive as one argument. The panel keeps them far below the
# kernel's per-argument limit; this refuses anything larger.
notify_rules_max_bytes=98304
# Same idea for the lists the phone fills: the panel and the Messages window are
# scrollable, so only the newest entries are worth carrying into the shell.
threads_max=200
messages_max=200

# The only directories a phone-supplied path may point into: KDE Connect's
# cache directory (album art, downloaded attachments) and its per-user
# notification icon directory.
phone_file_roots() {
  local user="${USER:-$(id -un)}" login home="${HOME:-}"
  login="$(id -un)"
  # Both cache locations, because the daemon reads XDG_CACHE_HOME from its own
  # environment, and both user names, because a daemon started with a stale USER
  # writes to the other directory. Rejection is silent either way, so a narrower
  # list costs a user their album art with no explanation.
  printf '%s\n' \
    "${XDG_CACHE_HOME:-$home/.cache}/kdeconnect.daemon" \
    "$home/.cache/kdeconnect.daemon" \
    "${TMPDIR:-/tmp}/kdeconnect_$user" \
    "${TMPDIR:-/tmp}/kdeconnect_$login" \
    "/tmp/kdeconnect_$user" \
    "/tmp/kdeconnect_$login" \
    | sort -u
}

# The FIFO reader, rather than a polling check, sets the exact disk ceiling.
# Each producer has its own process group so cleanup also stops descendants.
stop_capture() {
  local pid
  for pid in "${request_pid:-}" "${monitor_pid:-}"; do
    [[ -z $pid ]] || kill -KILL -- "-$pid" "$pid" 2>/dev/null || true
  done
  if [[ ${1:-} == abort && -n ${reader_pid:-} ]]; then kill "$reader_pid" 2>/dev/null || true; fi
  for pid in "${request_pid:-}" "${monitor_pid:-}" "${reader_pid:-}"; do
    [[ -z $pid ]] || wait "$pid" 2>/dev/null || true
  done
  request_pid="" monitor_pid="" reader_pid=""
}

cleanup_capture() {
  stop_capture abort
  [[ -z ${capture_dir:-} ]] || rm -rf -- "$capture_dir"
}

capture_ok() {
  if (( $(stat -c %s -- "$capture_file") >= capture_max_bytes )); then
    echo "Phone response exceeded the capture limit" >&2
    return 1
  fi
}

start_capture() {
  local duration="$1"
  shift
  capture_dir="$(mktemp -d)"
  capture_file="$capture_dir/signals"
  trap cleanup_capture EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
  mkfifo "$capture_dir/pipe"
  : >"$capture_file"
  head -c "$capture_max_bytes" <"$capture_dir/pipe" >"$capture_file" &
  reader_pid=$!
  setsid timeout --kill-after=1s 45s stdbuf -oL busctl --user --verbose --json=short \
    monitor -- org.kde.kdeconnect >"$capture_dir/pipe" 2>/dev/null &
  monitor_pid=$!
  sleep 0.1
  setsid timeout --kill-after=1s "$duration" busctl --user call -- \
    org.kde.kdeconnect "$device_path" org.kde.kdeconnect.device.conversations \
    "$@" >/dev/null 2>&1 &
  request_pid=$!
  while kill -0 "$request_pid" 2>/dev/null; do
    capture_ok || return 1
    sleep 0.05
  done
  if ! wait "$request_pid"; then
    echo "Phone request failed or timed out" >&2
    return 1
  fi
  request_pid=""
  capture_ok
}

percent_decode() {
  local encoded="$1" decoded="" escape
  while [[ $encoded == *%* ]]; do
    decoded+="${encoded%%\%*}"
    encoded="${encoded#*\%}"
    escape="${encoded:0:2}"
    [[ $escape =~ ^[0-9A-Fa-f]{2}$ ]] || return 1
    # Control characters are refused: %00 would truncate the path as it
    # decodes, and nothing the daemon writes contains them. Every other byte,
    # including UTF-8, decodes as it is.
    case "${escape,,}" in
      0* | 1* | 7f) return 1 ;;
    esac
    printf -v escape "\\x$escape"
    decoded+="$escape"
    encoded="${encoded:2}"
  done
  printf '%s' "$decoded$encoded"
}

# Canonical path of "$1" when it is a regular file inside one of the KDE
# Connect directories and no larger than "$2" bytes; empty otherwise. Symlinks
# are resolved first, so a link planted inside those directories cannot point at
# something else, and a second hard link is refused because the same inode can
# then be reached from outside them. Rejection is an empty result, not a status:
# call sites test the value, and a caller that tested $? would fail open.
phone_file() {
  local path="$1" limit="$2" real root size links
  [[ -n $path && $path != *[$'\001'-$'\037'$'\177']* && $limit =~ ^[0-9]+$ ]] || return 0
  real="$(readlink -f -- "$path" 2>/dev/null || true)"
  [[ -n $real && $real != *[$'\001'-$'\037'$'\177']* && -f $real && -r $real ]] || return 0
  links="$(stat -c %h -- "$real" 2>/dev/null || printf '1')"
  [[ $links =~ ^[0-9]+$ && $links -le 1 ]] || return 0
  while IFS= read -r root; do
    root="$(readlink -f -- "$root" 2>/dev/null || true)"
    [[ -n $root && $real == "$root"/* ]] || continue
    size="$(stat -c %s -- "$real" 2>/dev/null || printf '0')"
    (( size > 0 && size <= limit )) || return 0
    printf '%s' "$real"
    return 0
  done < <(phone_file_roots)
}

# A phone-supplied path or file:// URL reduced to a local file we accept, or
# empty. Every other scheme (http, https, data, qrc, image://) is dropped.
phone_local_path() {
  local raw="${1:-}" limit="${2:-0}" path
  case $raw in
    "") return 0 ;;
    file://*) path="$(percent_decode "${raw#file://}")" || return 0 ;;
    /*) path="$raw" ;;
    *) return 0 ;;
  esac
  [[ $path == /* ]] || return 0
  phone_file "$path" "$limit"
}

# Phone data is only ever decoded as a small raster image, so a phone-supplied
# SVG or other markup cannot reach the image loader.
raster_image() {
  local magic
  magic="$(head -c 12 -- "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  case $magic in
    89504e470d0a1a0a*) return 0 ;;  # PNG
    ffd8ff*) return 0 ;;            # JPEG
    47494638*) return 0 ;;          # GIF
    424d*) return 0 ;;              # BMP
    52494646*57454250) return 0 ;;  # WebP
  esac
  return 1
}

# Canonical path of an image KDE Connect wrote for the phone (album art,
# notification icon), or empty. The path is handed to the panel as it is: the
# QML side builds the file:// URI and does the percent encoding, so a % in a name
# cannot survive into the URI and decode to a different file.
phone_image_path() {
  local path
  path="$(phone_local_path "${1:-}" "${2:-0}")"
  [[ -n $path ]] || return 0
  raster_image "$path" || return 0
  printf '%s' "$path"
}

# Phone text is shown, never trusted, and never allowed to be arbitrarily long.
truncate_text() {
  local value="${1:-}" limit="${2:-1024}"
  if (( ${#value} > limit )); then
    printf '%s' "${value:0:limit}"
  else
    printf '%s' "$value"
  fi
}

# Every value below arrives as text over D-Bus, so an unexpected one would make
# jq fail and take the whole status down with it. Numbers and booleans fall back
# instead, which shows as a missing reading rather than an empty panel.
numeric_or() {
  local value="${1:-}" fallback="$2"
  [[ $value =~ ^-?(0|[1-9][0-9]{0,9})$ ]] || value="$fallback"
  printf '%s' "$value"
}

boolean_or() {
  local value="${1:-}" fallback="$2"
  [[ $value == true || $value == false ]] || value="$fallback"
  printf '%s' "$value"
}

# Evidence used to enable actions must not survive a failed/partial response.
# Unlike optional content reads, metadata is captured privately and printed only
# after successful exit, with a smaller independent ceiling.
strict_metadata() {
  local raw LC_ALL=C
  raw="$(timeout --kill-after=1s 2s "$@" 2>/dev/null | head -c 65537)" || return 1
  (( ${#raw} <= 65536 )) || return 1
  printf '%s\n' "$raw"
}

metadata_boolean() {
  local raw
  raw="$(strict_metadata busctl --user get-property -- "$kdeconnect_service" "$1" \
    org.kde.kdeconnect.device "$2")" || { printf 'null'; return; }
  case $raw in 'b true') printf 'true' ;; 'b false') printf 'false' ;; *) printf 'null' ;; esac
}

backend_version() {
  local raw
  raw="$(strict_metadata kdeconnect-cli --version || true)"
  if [[ $raw =~ ^kdeconnect-cli[[:space:]]+([0-9]{1,4}\.[0-9]{1,4}(\.[0-9]{1,6})?([-+][A-Za-z0-9][A-Za-z0-9._+-]{0,31})?)$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

backend_owner() {
  strict_metadata busctl --user --json=short call -- org.freedesktop.DBus \
    /org/freedesktop/DBus org.freedesktop.DBus GetNameOwner s org.kde.kdeconnect \
    | jq -r 'if .type == "s" and (.data[0] | type == "string")
        and (.data[0] | test("^:[0-9]+\\.[0-9]+$")) then .data[0] else empty end' 2>/dev/null || true
}

plugin_list() {
  local path="$1" kind="$2" raw
  if [[ $kind == supported ]]; then
    raw="$(strict_metadata busctl --user --json=short get-property -- "$kdeconnect_service" \
      "$path" org.kde.kdeconnect.device supportedPlugins || true)"
  else
    raw="$(strict_metadata busctl --user --json=short call -- "$kdeconnect_service" \
      "$path" org.kde.kdeconnect.device loadedPlugins || true)"
  fi
  jq -c --arg kind "$kind" '
    (if $kind == "supported" then .data else .data[0] end) as $list |
    if .type == "as" and ($list | type == "array") and ($list | length <= 128)
       and ($list | all(.[]; type == "string" and test("^kdeconnect_[a-z0-9_]{1,80}$")))
    then $list else null end' <<<"$raw" 2>/dev/null || printf 'null\n'
}

capabilities_json() {
  local path="$1" paired="$2" reachable="$3" supported loaded name plugin enabled raw
  local -a evidence=()
  supported="$(plugin_list "$path" supported)"; supported="${supported:-null}"
  loaded="$(plugin_list "$path" loaded)"; loaded="${loaded:-null}"
  for name in messaging contacts notifications sharing clipboard ring media battery files connectivity; do
    case $name in
      messaging) plugin=kdeconnect_sms ;;
      sharing) plugin=kdeconnect_share ;;
      ring) plugin=kdeconnect_findmyphone ;;
      media) plugin=kdeconnect_mprisremote ;;
      files) plugin=kdeconnect_sftp ;;
      connectivity) plugin=kdeconnect_connectivity_report ;;
      *) plugin="kdeconnect_$name" ;;
    esac
    raw="$(strict_metadata busctl --user --json=short call -- "$kdeconnect_service" \
      "$path" org.kde.kdeconnect.device isPluginEnabled s "$plugin" || true)"
    enabled="$(jq -c 'if .type == "b" and (.data[0] | type == "boolean") then .data[0] else null end' <<<"$raw" 2>/dev/null || true)"
    evidence+=("$(jq -cn --arg name "$name" --arg plugin "$plugin" --argjson enabled "${enabled:-null}" \
      --argjson supported "$supported" --argjson loaded "$loaded" \
      '{key:$name,value:{plugin:$plugin,enabled:$enabled,permission:"unknown",
        supported:(if $supported == null then null else ($supported | index($plugin) != null) end),
        loaded:(if $loaded == null then null else ($loaded | index($plugin) != null) end)}}')")
  done
  printf '%s\n' "${evidence[@]}" | jq -sc --argjson paired "$paired" --argjson reachable "$reachable" '
    from_entries | with_entries(.value |= (
      . + (if $paired == false then {state:"unknown",reason:"unpaired"}
           elif $reachable == false then {state:"unknown",reason:"offline"}
           elif $paired != true or $reachable != true then {state:"unknown",reason:"connection-unknown"}
           elif .supported == false then {state:"unsupported",reason:"not-supported"}
           elif .enabled == false then {state:"disabled",reason:"plugin-disabled"}
           elif .supported == true and .enabled == true and .loaded == true then {state:"available",reason:"plugin-ready"}
           elif .loaded == false then {state:"unknown",reason:"plugin-not-loaded"}
           else {state:"unknown",reason:"capability-unknown"} end)))'
}

require_messaging_capability() {
  local device_id="$1" plugin="$2" owner path paired reachable loaded
  owner="$(backend_owner)"
  [[ -n $owner ]] || { echo 'KDE Connect backend is unavailable' >&2; return 1; }
  kdeconnect_service="$owner"
  path="/modules/kdeconnect/devices/$device_id"
  paired="$(metadata_boolean "$path" isPaired)"
  reachable="$(metadata_boolean "$path" isReachable)"
  loaded="$(plugin_list "$path" loaded)"
  if [[ $paired != true || $reachable != true ]] \
      || ! jq -e --arg plugin "$plugin" 'type == "array" and index($plugin) != null' <<<"${loaded:-null}" >/dev/null 2>&1 \
      || [[ $(backend_owner) != "$owner" ]]; then
    echo 'Phone messaging is not ready; check pairing, connection and enabled plugins' >&2
    return 1
  fi
}

status_failure() {
  local installed="$1" version="$2" reason="$3" code
  case $reason in
    'KDE Connect backend is unavailable') code=backend-unavailable ;;
    'KDE Connect restarted during refresh') code=backend-restarted ;;
    *) code=discovery-failed ;;
  esac
  jq -cn --arg code "$code" --argjson installed "$installed" --arg version "$version" --arg reason "$reason" \
    '{schemaVersion:1,ok:false,installed:$installed,devices:[],observedAt:0,discoveryTruncated:false,
      backend:{name:"kdeconnect",available:false,version:(if $version == "" then null else $version end),versionSource:"kdeconnect-cli"},
      statusText:$reason,failureReason:$code}'
}

status() {
  local diagnostics="${1:-false}" version owner end_owner raw id name device_path paired reachable type
  local charge charging network_strength network_type notification_state media capabilities count=0 truncated=false
  local -a devices=()
  local -A seen_devices=()
  if ! command -v kdeconnect-cli >/dev/null 2>&1; then
    jq -cn '{schemaVersion:1,ok:true,installed:false,devices:[],observedAt:0,discoveryTruncated:false,
      backend:{name:"kdeconnect",available:false,version:null,versionSource:"kdeconnect-cli"},statusText:"KDE Connect is not installed"}'
    return
  fi
  version="$(backend_version)"
  owner="$(backend_owner)"
  if [[ -z $owner ]]; then
    status_failure true "$version" 'KDE Connect backend is unavailable'
    [[ $diagnostics == true ]] && return 0
    return 1
  fi
  kdeconnect_service="$owner"
  # Enumerate IDs only. Names are read from the owner-bound object, so a hostile
  # newline in a device name cannot masquerade as a second discovery entry.
  if ! raw="$(timeout --kill-after=1s 5s kdeconnect-cli --list-devices --id-only 2>/dev/null | head -c "$capture_max_bytes")"; then
    status_failure true "$version" 'Could not refresh phone status'
    [[ $diagnostics == true ]] && return 0
    return 1
  fi
  while IFS= read -r id; do
    [[ $id =~ ^[A-Za-z0-9]{1,128}$ ]] || continue
    [[ -z ${seen_devices[$id]:-} ]] || continue
    seen_devices[$id]=1
    if (( count >= 8 )); then truncated=true; break; fi
    count=$((count + 1))
    device_path="/modules/kdeconnect/devices/$id"
    name="$(truncate_text "$(dbus_property "$device_path" org.kde.kdeconnect.device name s)" "$name_max_chars")"
    [[ -n $name ]] || name='Unnamed device'
    type="$(dbus_property "$device_path" org.kde.kdeconnect.device type s)"
    case $type in phone|tablet|desktop|laptop|tv) ;; *) type=unknown ;; esac
    paired="$(metadata_boolean "$device_path" isPaired)"
    reachable="$(metadata_boolean "$device_path" isReachable)"
    capabilities="$(capabilities_json "$device_path" "$paired" "$reachable")"
    charge=null; charging=null; network_strength=null; network_type=''; media=null
    notification_state='{"notifications":[],"sources":null}'
    # Diagnostics only examines backend/device/plugin metadata. Never collect
    # notification bodies, contact records, media titles or cached content.
    if [[ $diagnostics == false && $paired == true && $reachable == true ]]; then
      charge="$(numeric_or "$(dbus_property "$device_path/battery" org.kde.kdeconnect.device.battery charge i)" null)"
      charging="$(boolean_or "$(dbus_property "$device_path/battery" org.kde.kdeconnect.device.battery isCharging b)" null)"
      network_strength="$(numeric_or "$(dbus_property "$device_path/connectivity_report" org.kde.kdeconnect.device.connectivity_report cellularNetworkStrength i)" null)"
      network_type="$(dbus_property "$device_path/connectivity_report" org.kde.kdeconnect.device.connectivity_report cellularNetworkType s)"
      notification_state="$(notification_json "$id")"
      media="$(media_json "$device_path")"
    fi
    devices+=("$(jq -cs --arg id "$id" --arg name "$name" --arg type "$type" \
      --argjson paired "$paired" --argjson reachable "$reachable" --argjson capabilities "$capabilities" \
      --argjson charge "$charge" --argjson charging "$charging" --argjson networkStrength "$network_strength" \
      --arg networkType "$(truncate_text "$network_type" 32)" --argjson media "$media" \
      '{id:$id,name:$name,type:$type,paired:$paired,reachable:$reachable,
        connectionState:(if $paired == false then "unpaired" elif $reachable == false then "offline"
          elif $paired == true and $reachable == true then "ready" else "unknown" end),capabilities:$capabilities,
        battery:{charge:$charge,charging:$charging},connectivity:{strength:$networkStrength,type:$networkType},
        notifications:.[0].notifications,notificationSources:.[0].sources,media:$media}' <<<"$notification_state")")
  done <<<"$raw"
  end_owner="$(backend_owner)"
  if [[ $end_owner != "$owner" ]]; then
    status_failure true "$version" 'KDE Connect restarted during refresh'
    [[ $diagnostics == true ]] && return 0
    return 1
  fi
  local observed_at
  observed_at="$(date +%s%3N)"
  printf '%s\n' "${devices[@]}" | jq -sc --arg version "$version" --argjson observedAt "$observed_at" \
    --argjson truncated "$truncated" --argjson diagnostics "$diagnostics" '
    . as $devices | {schemaVersion:1,ok:true,installed:true,observedAt:$observedAt,discoveryTruncated:$truncated,
      backend:{name:"kdeconnect",available:true,version:(if $version == "" then null else $version end),versionSource:"kdeconnect-cli"},
      devices:(if $diagnostics then to_entries | map({label:("device-" + ((.key + 1)|tostring)),
        type:.value.type,paired:.value.paired,reachable:.value.reachable,connectionState:.value.connectionState,capabilities:.value.capabilities})
        else . end),statusText:(if length == 0 then "No devices found" else "Device status refreshed" end)}'
}

# Reads at most notifications_read_max records per device. Metadata (app name
# and package) is read for every scanned record so the panel can offer per-app
# rules and explain filtered-empty lists, but a title, body, icon or reply ID is
# only read for the first notifications_max records the policy permits.
notification_json() {
  local device_id="$1" notification_root="/modules/kdeconnect/devices/$1/notifications" raw notification_id notification_path
  local app_name package_name title text icon_path dismissable reply_id is_conversation permitted source_allowed
  local -a notifications=() observed=()
  local read_count=0 kept_count=0 scan_truncated=false

  raw="$(dbus_bounded 5s busctl --user --json=short call -- "$kdeconnect_service" \
    "$notification_root" org.kde.kdeconnect.device.notifications activeNotifications)"
  while IFS= read -r notification_id; do
    if (( read_count >= notifications_read_max )); then scan_truncated=true; break; fi
    read_count=$((read_count + 1))
    [[ $notification_id =~ ^[A-Za-z0-9_][A-Za-z0-9._:-]{0,127}$ ]] || continue
    notification_path="$notification_root/$notification_id"
    app_name="$(truncate_text "$(dbus_json_property "$notification_path" appName)" "$name_max_chars")"
    package_name="$(notification_package "$(truncate_text "$(dbus_json_property "$notification_path" internalId)" "$name_max_chars")")"
    source_allowed=false
    notification_allowed "$app_name" "$package_name" && source_allowed=true
    permitted=false
    notification_permitted "$device_id" "$app_name" "$package_name" && permitted=true
    observed+=("$app_name" "$package_name" "$permitted" "$source_allowed")
    [[ $permitted == true && $kept_count -lt $notifications_max ]] || continue
    kept_count=$((kept_count + 1))
    title="$(truncate_text "$(dbus_json_property "$notification_path" title)" "$title_max_chars")"
    text="$(truncate_text "$(dbus_json_property "$notification_path" text)" "$body_max_chars")"
    icon_path="$(phone_image_path "$(dbus_json_property "$notification_path" iconPath)" "$icon_max_bytes")"
    dismissable="$(boolean_or "$(dbus_json_property "$notification_path" dismissable)" false)"
    reply_id="$(truncate_text "$(dbus_json_property "$notification_path" replyId)" "$id_max_chars")"
    is_conversation="$(boolean_or "$(dbus_json_property "$notification_path" isConversation)" false)"
    notifications+=("$(jq -cn \
      --arg id "$notification_id" \
      --arg appName "$app_name" \
      --arg packageName "$package_name" \
      --arg title "$title" \
      --arg text "$text" \
      --arg iconPath "$icon_path" \
      --argjson dismissable "$dismissable" \
      --arg replyId "$reply_id" \
      --argjson isConversation "$is_conversation" \
      '{id: $id, appName: $appName, packageName: $packageName, title: $title, text: $text, iconPath: $iconPath, dismissable: $dismissable, replyId: $replyId, replyable: ($replyId != ""), isConversation: $isConversation}')")
  done < <(jq -r '.data[0][]?' <<<"$raw" 2>/dev/null)

  # Bodies travel on stdin because 25 of them can exceed one argument's limit.
  # Observed metadata is at most four short fields per scanned record. jq still
  # parses option-like arguments after --args, so -- ends its options first.
  { (( ${#notifications[@]} == 0 )) || printf '%s\n' "${notifications[@]}"; } \
    | jq -sc --argjson scanTruncated "$scan_truncated" '
      . as $notifications
      | [$ARGS.positional as $fields | range(0; $fields | length; 4) | $fields[.:. + 4]
          | {appName: .[0], packageName: .[1], permitted: (.[2] == "true"), sourceAllowed: (.[3] == "true")}
          | .key = (if .packageName != "" then "pkg:" + .packageName
              elif .appName != "" then "app:" + .appName else "" end)] as $records
      | {notifications: $notifications, sources: {
          examined: ($records | length), scanTruncated: $scanTruncated,
          permitted: ([$records[] | select(.permitted)] | length),
          hidden: ([$records[] | select(.permitted | not)] | length),
          listed: ($notifications | length),
          unidentified: ([$records[] | select(.key == "")] | length),
          apps: ([$records[] | select(.key != "")] | group_by(.key)
            | map({key: .[0].key, appName: .[0].appName, packageName: .[0].packageName, count: length,
                permitted: any(.[]; .permitted), sourceAllowed: any(.[]; .sourceAllowed)})
            | sort_by(.appName | ascii_downcase))}}' --args -- "${observed[@]}"
}

# KDE Connect reports an Android notification's StatusBarNotification key,
# "user|package|id|tag|uid", as its internalId. Only that envelope yields a
# package identity. KDE Connect's own numeric IDs and anything malformed yield
# none, rather than treating the whole value as a package. Bracket ranges match
# non-ASCII letters in some locales, so the characters are listed exactly.
notification_package() {
  local internal_id="${1:-}" letter='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ' digit='0123456789'
  local segment="[$letter][$letter${digit}_]*"
  if [[ $internal_id =~ ^-?[$digit]{1,10}\|($segment(\.$segment)*)\|-?[$digit]{1,10}\| ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

# Per-app rules from the panel, scoped to one KDE device each. Only an exact
# identity matches: "pkg:<package>" for a validated package, otherwise
# "app:<name>", which the phone chooses and other apps may share.
declare -A notify_rules=()
load_notify_rules() {
  local device identity state
  [[ -n $NOTIFY_RULES_SET ]] || return 0
  (( $(printf '%s' "$NOTIFY_RULES" | wc -c) <= notify_rules_max_bytes )) || usage
  jq -e 'type == "object"' <<<"$NOTIFY_RULES" >/dev/null 2>&1 || usage
  while IFS= read -r -d '' device && IFS= read -r -d '' identity && IFS= read -r -d '' state; do
    notify_rules["$device|$identity"]="$state"
  done < <(jq -j '
    to_entries[:16][] | select(.key | test("^[A-Za-z0-9]{1,128}$")) | .key as $device
    | .value | objects | to_entries[:100][]
    | select((.value == "allow" or .value == "mute") and (.key | length <= 260)
        and (.key | test("^(pkg|app):.")) and (.key | explode | all(. > 31 and . != 127)))
    | "\($device)\u0000\(.key)\u0000\(.value)\u0000"' <<<"$NOTIFY_RULES")
}

# Exact mute, then exact allow, then the legacy source filter. Used by status,
# popup workers and dismiss-all alike, so none of them can disagree.
notification_permitted() {
  local device_id="$1" app_name="$2" package_name="$3" rule=""
  if [[ -n $package_name ]]; then
    rule="${notify_rules["$device_id|pkg:$package_name"]:-}"
  elif [[ -n $app_name ]]; then
    rule="${notify_rules["$device_id|app:$app_name"]:-}"
  fi
  [[ $rule != mute ]] || return 1
  [[ $rule != allow ]] || return 0
  notification_allowed "$app_name" "$package_name"
}

notification_allowed() {
  local app_name="${1,,}" package_name="${2,,}" term

  # --notify-apps wins when given, including an empty list (allow everything).
  if [[ -n $NOTIFY_APPS_SET ]]; then
    [[ -z ${NOTIFY_APPS//[[:space:]]/} ]] && return 0
    local -a terms=()
    IFS=',' read -ra terms <<<"$NOTIFY_APPS"
    for term in "${terms[@]}"; do
      term="${term,,}"
      term="${term#"${term%%[![:space:]]*}"}"
      term="${term%"${term##*[![:space:]]}"}"
      [[ -n $term ]] || continue
      [[ $app_name == *"$term"* || $package_name == *"$term"* ]] && return 0
    done
    return 1
  fi

  case "$package_name" in
    com.google.android.apps.messaging|com.samsung.android.messaging|com.android.messaging|com.android.mms|com.azure.authenticator|com.google.android.apps.authenticator2|com.whatsapp)
      return 0
      ;;
  esac

  case "$app_name" in
    messages|google\ messages|samsung\ messages|messaging|authenticator|microsoft\ authenticator|google\ authenticator|whatsapp)
      return 0
      ;;
  esac

  return 1
}

dbus_json_property() {
  local path="$1" property="$2"
  dbus_bounded 5s busctl --user --json=short get-property -- "$kdeconnect_service" "$path" \
    org.kde.kdeconnect.device.notifications.notification "$property" \
    | jq -r '.data // empty' 2>/dev/null || true
}

dbus_property() {
  local path="$1" interface="$2" property="$3" signature="$4" raw
  raw="$(dbus_bounded 5s busctl --user get-property -- "$kdeconnect_service" "$path" "$interface" "$property")"
  [[ $raw == "$signature "* ]] || return 0
  raw="${raw#* }"
  if [[ $signature == s ]]; then
    jq -r '.' <<<"$raw" 2>/dev/null || true
  else
    printf '%s\n' "$raw"
  fi
}

# The phone's current media state as reported by KDE Connect's mprisremote
# plugin, or null when nothing is playing (or the plugin interface is gone,
# e.g. the phone has not granted media control permissions).
media_json() {
  local device_path="$1" mpris_path="$1/mprisremote" raw player_list
  local player title artist album volume length position is_playing can_seek album_art
  raw="$(dbus_bounded 5s busctl --user --json=short get-property -- "$kdeconnect_service" \
    "$mpris_path" org.kde.kdeconnect.device.mprisremote playerList)"
  player_list="$(jq -c --argjson max "$players_max" --argjson chars "$media_max_chars" \
    '[(.data // [])[] | (tostring | .[0:$chars])][0:$max]' <<<"$raw" 2>/dev/null || true)"
  if [[ -z $player_list || $player_list == "[]" ]]; then
    printf 'null\n'
    return
  fi
  player="$(truncate_text "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote player s)" "$media_max_chars")"
  title="$(truncate_text "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote title s)" "$media_max_chars")"
  artist="$(truncate_text "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote artist s)" "$media_max_chars")"
  album="$(truncate_text "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote album s)" "$media_max_chars")"
  volume="$(numeric_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote volume i)" 0)"
  length="$(numeric_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote length i)" 0)"
  position="$(numeric_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote position i)" 0)"
  is_playing="$(boolean_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote isPlaying b)" false)"
  can_seek="$(boolean_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote canSeek b)" false)"
  album_art="$(phone_image_path "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote localAlbumArtUrl s)" "$album_art_max_bytes")"
  jq -cn \
    --arg player "$player" \
    --arg title "$title" \
    --arg artist "$artist" \
    --arg album "$album" \
    --argjson volume "$volume" \
    --argjson length "$length" \
    --argjson position "$position" \
    --argjson isPlaying "$is_playing" \
    --argjson canSeek "$can_seek" \
    --arg albumArt "${album_art:-}" \
    --argjson players "$player_list" \
    '{player: $player, title: $title, artist: $artist, album: $album,
      volume: $volume, length: $length,
      position: (if $position < 0 then 0 else $position end),
      isPlaying: $isPlaying, canSeek: $canSeek, albumArt: $albumArt, players: $players}'
}

ring() {
  local device_id="${1:-}"
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ ]] || usage
  command -v kdeconnect-cli >/dev/null 2>&1 || {
    echo "KDE Connect is not installed" >&2
    exit 1
  }
  timeout --kill-after=1s 10s kdeconnect-cli --device "$device_id" --ring
}

send_clipboard() {
  local device_id="${1:-}"
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ ]] || usage
  command -v kdeconnect-cli >/dev/null 2>&1 || {
    echo "KDE Connect is not installed" >&2
    exit 1
  }
  timeout --kill-after=1s 10s kdeconnect-cli --device "$device_id" --send-clipboard
}

media() {
  local device_id="${1:-}"
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ ]] || usage
  media_json "/modules/kdeconnect/devices/$device_id"
}

# The Android side interprets these standard MPRIS action names. The full set
# is allowed at the CLI boundary; the panel currently sends only PlayPause,
# Previous, and Next.
media_action() {
  local device_id="${1:-}" action="${2:-}"
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ && $action =~ ^(PlayPause|Play|Pause|Next|Previous|Stop|Rewind|FastForward)$ ]] || usage
  timeout --kill-after=1s 10s busctl --user call -- "$kdeconnect_service" "/modules/kdeconnect/devices/$device_id/mprisremote" \
    org.kde.kdeconnect.device.mprisremote sendAction s "$action" >/dev/null
}

media_volume() {
  local device_id="${1:-}" volume="${2:-}"
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ && $volume =~ ^[0-9]{1,3}$ && $((10#$volume)) -le 100 ]] || usage
  timeout --kill-after=1s 10s busctl --user call -- "$kdeconnect_service" "/modules/kdeconnect/devices/$device_id/mprisremote" \
    org.freedesktop.DBus.Properties Set ssv \
    org.kde.kdeconnect.device.mprisremote volume i "$((10#$volume))" >/dev/null
}

# Seek to an absolute position (milliseconds). The plugin only exposes a
# relative seek, so the offset is computed from the live position here.
media_seek() {
  local device_id="${1:-}" target="${2:-}" mpris_path position offset
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ && $target =~ ^[0-9]{1,10}$ && $((10#$target)) -le 2147483647 ]] || usage
  mpris_path="/modules/kdeconnect/devices/$device_id/mprisremote"
  [[ $(media_json "/modules/kdeconnect/devices/$device_id") != null ]] || {
    echo "No media is playing on the phone" >&2
    exit 1
  }
  position="$(numeric_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote position i)" "")"
  [[ -n $position ]] || {
    echo "No media is playing on the phone" >&2
    exit 1
  }
  [[ $position =~ ^-?[0-9]{1,10}$ ]] || usage
  offset=$((10#$target - position))
  (( offset >= -2147483648 && offset <= 2147483647 )) || usage
  timeout --kill-after=1s 10s busctl --user call -- "$kdeconnect_service" "$mpris_path" \
    org.kde.kdeconnect.device.mprisremote seek i "$offset" >/dev/null
}

dismiss_notification() {
  local device_id="${1:-}" notification_id="${2:-}"
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ && $notification_id =~ ^[A-Za-z0-9_][A-Za-z0-9._:-]{0,127}$ && $notification_id != -* && $notification_id != . && $notification_id != .. ]] || usage
  timeout --kill-after=1s 10s busctl --user call -- "$kdeconnect_service" \
    "/modules/kdeconnect/devices/$device_id/notifications/$notification_id" \
    org.kde.kdeconnect.device.notifications.notification dismiss >/dev/null
}

# Phone text reaches a popup, and notification daemons render both the summary
# and the body as markup, so it is escaped first. sed does the escaping because
# bash 5.2 and newer read & in a ${value//pattern/replacement} replacement as
# the matched text, which silently swallowed the ampersands here.
notify_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

handle_posted() {
  local device_id="$1" notification_id="$2" notification_path app_name package_name title text silent summary body action
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ && $notification_id =~ ^[A-Za-z0-9_][A-Za-z0-9._:-]{0,127}$ ]] || return 0
  sleep 0.3
  notification_path="/modules/kdeconnect/devices/$device_id/notifications/$notification_id"
  # On reconnect the phone re-sends every notification still in its shade and
  # the daemon re-posts each one flagged silent. Only new ones get a popup.
  silent="$(dbus_json_property "$notification_path" silent)"
  [[ $silent == true ]] && return 0
  [[ $NOTIFY_POPUPS == off ]] && return 0
  app_name="$(truncate_text "$(dbus_json_property "$notification_path" appName)" "$name_max_chars")"
  package_name="$(notification_package "$(truncate_text "$(dbus_json_property "$notification_path" internalId)" "$name_max_chars")")"
  notification_permitted "$device_id" "$app_name" "$package_name" || return 0
  title="$(truncate_text "$(dbus_json_property "$notification_path" title)" "$title_max_chars")"
  text="$(truncate_text "$(dbus_json_property "$notification_path" text)" "$body_max_chars")"
  # A notification dismissed between the signal and this read has no fields
  # left, and a popup with an empty title is worse than none.
  if [[ -z $title && -z $text && -z $app_name ]]; then
    return 0
  fi
  summary="$(notify_escape "${app_name:-Phone notification}")"
  body="Open OmaLink to read it"
  action="$(timeout --kill-after=1s 30s notify-send -a OmaLink \
    -A "default=Open" -- "$summary" "$body" 2>/dev/null || true)"
  if [[ $action == default ]]; then
    open_panel || true
  fi
}

# Open the OmaLink panel on the focused monitor. Panels register one IPC
# target per screen ("omalink.phone.<output>"); fall back to the plain target
# (single-bar setups) and then to any registered omalink target. A missing
# target prints "Target not found." with exit 0, so success is empty output.
open_panel() {
  local shell_dir="${OMARCHY_PATH:-/usr/share/omarchy}/shell" focused target result
  local -a targets=("omalink.phone")
  focused="$(hyprctl -j monitors 2>/dev/null \
    | jq -r '[.[] | select(.focused == true) | .name][0] // empty' 2>/dev/null || true)"
  # A monitor name with a space in it used to split into two arguments here.
  if [[ -n $focused ]]; then
    targets=("omalink.phone.$focused" "${targets[@]}")
  fi
  for target in "${targets[@]}"; do
    result="$(qs -p "$shell_dir" ipc call "$target" open 2>&1 || true)"
    [[ -n $result ]] || return 0
  done
  while IFS= read -r target; do
    result="$(qs -p "$shell_dir" ipc call "$target" open 2>&1 || true)"
    [[ -n $result ]] || return 0
  done < <(qs -p "$shell_dir" ipc show 2>/dev/null | sed -n 's/^target \(omalink\.phone[^ ]*\).*/\1/p')
  return 1
}

watch() {
  command -v dbus-monitor >/dev/null 2>&1 || { echo "dbus-monitor is required" >&2; exit 1; }
  # Never use shared /tmp names or trust a pid left by another process.
  local runtime="${XDG_RUNTIME_DIR:-}" work monitor_pid="" pid line device_id="" notification_id
  local -a workers=() live=() options=(--popups "$NOTIFY_POPUPS")
  [[ -n $runtime && -d $runtime && ! -L $runtime && -O $runtime ]] || {
    echo "A private XDG_RUNTIME_DIR is required" >&2; exit 1;
  }
  [[ $(stat -c %a -- "$runtime") == 700 ]] || {
    echo "XDG_RUNTIME_DIR must have mode 700" >&2; exit 1;
  }
  [[ ! -L $runtime/omalink-watch.lock ]] || exit 1
  exec 9>>"$runtime/omalink-watch.lock"
  flock 9
  work="$(mktemp -d "$runtime/omalink-watch.XXXXXX")"
  cleanup_watch() {
    for pid in "$monitor_pid" "${workers[@]}"; do
      [[ -z $pid ]] || kill -KILL -- "-$pid" "$pid" 2>/dev/null || true
    done
    for pid in "$monitor_pid" "${workers[@]}"; do
      [[ -z $pid ]] || wait "$pid" 2>/dev/null || true
    done
    rm -rf -- "$work"
  }
  trap cleanup_watch EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
  [[ -z $NOTIFY_APPS_SET ]] || options+=(--notify-apps "$NOTIFY_APPS")
  [[ -z $NOTIFY_RULES_SET ]] || options+=(--notify-rules "$NOTIFY_RULES")
  mkfifo "$work/signals"
  setsid timeout --kill-after=1s 1h dbus-monitor --session \
    "type='signal',sender='org.kde.kdeconnect',interface='org.kde.kdeconnect.device.notifications',member='notificationPosted'" \
    >"$work/signals" 2>/dev/null 9>&- &
  monitor_pid=$!
  while IFS= read -r -n 4096 line; do
    case $line in
      *"member=notificationPosted"*)
        device_id="${line#*path=/modules/kdeconnect/devices/}"
        device_id="${device_id%%/*}"
        ;;
      *'string "'*)
        notification_id="${line#*string \"}"
        notification_id="${notification_id%\"*}"
        [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ && $notification_id =~ ^[A-Za-z0-9_][A-Za-z0-9._:-]{0,127}$ ]] || continue
        live=()
        for pid in "${workers[@]}"; do
          if kill -0 "$pid" 2>/dev/null; then live+=("$pid"); else wait "$pid" || true; fi
        done
        workers=("${live[@]}")
        # Dropped popups stay available in the panel. A flood never creates
        # unbounded helpers waiting for popup actions.
        if [[ $NOTIFY_POPUPS == on ]] && (( ${#workers[@]} < 4 )); then
          setsid "$0" "${options[@]}" _posted "$device_id" "$notification_id" 9>&- &
          workers+=("$!")
        fi
        printf 'posted %s %s\n' "$device_id" "$notification_id"
        device_id=""
        ;;
    esac
  done <"$work/signals"
  for pid in "${workers[@]}"; do wait "$pid" || true; done
  exit 0
}

dismiss_all_notifications() {
  local device_id="${1:-}" notification_root raw notification_id notification_path app_name package_name
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ ]] || usage
  local read_count=0
  notification_root="/modules/kdeconnect/devices/$device_id/notifications"
  raw="$(dbus_bounded 5s busctl --user --json=short call -- "$kdeconnect_service" \
    "$notification_root" org.kde.kdeconnect.device.notifications activeNotifications)"
  while IFS= read -r notification_id; do
    (( read_count < notifications_read_max )) || break
    read_count=$((read_count + 1))
    [[ $notification_id =~ ^[A-Za-z0-9_][A-Za-z0-9._:-]{0,127}$ ]] || continue
    notification_path="$notification_root/$notification_id"
    app_name="$(truncate_text "$(dbus_json_property "$notification_path" appName)" "$name_max_chars")"
    package_name="$(notification_package "$(truncate_text "$(dbus_json_property "$notification_path" internalId)" "$name_max_chars")")"
    notification_permitted "$device_id" "$app_name" "$package_name" || continue
    timeout --kill-after=1s 10s busctl --user call -- "$kdeconnect_service" "$notification_path" \
      org.kde.kdeconnect.device.notifications.notification dismiss >/dev/null 2>&1 || true
  done < <(jq -r '.data[0][]?' <<<"$raw" 2>/dev/null)
}

contact_records_json() {
  local device_id="$1" device_path contact_dir
  device_path="/modules/kdeconnect/devices/$device_id"
  contact_dir="${XDG_DATA_HOME:-${HOME:-}/.local/share}/kpeoplevcard/kdeconnect-$device_id"

  timeout --kill-after=1s 10s busctl --user call -- "$kdeconnect_service" "$device_path/contacts" \
    org.kde.kdeconnect.device.contacts synchronizeRemoteWithLocal >/dev/null 2>&1 || true

  if [[ ! -d $contact_dir || -L $contact_dir ]]; then
    printf '%s\n' '[]'
    return
  fi

  # Limit files, bytes, and numbers while reading, before awk or jq hold them.
  {
    local file count=0
    while IFS= read -r -d '' file; do
      (( count < contacts_max )) || break
      count=$((count + 1))
      head -c 1048576 -- "$file"
      printf '\n'
    done < <(find "$contact_dir" -maxdepth 1 -type f -name '*.vcf' -size -1048577c -print0)
  } 2>/dev/null | head -c "$capture_max_bytes" |
  awk -v max="$contacts_max" '
    BEGIN { emitted = 0 }
    function value() { return substr($0, index($0, ":") + 1) }
    /^BEGIN:VCARD/ { name = ""; phone_count = 0 }
    /^FN[;:]/ { name = substr(value(), 1, 256); gsub(/\\,/, ",", name); gsub(/\\;/, ";", name) }
    /^TEL[;:]/ { if (phone_count < 20) phones[++phone_count] = substr(value(), 1, 128) }
    /^END:VCARD/ {
      gsub(/[\t\r\n]/, " ", name)
      if (length(name) > 256) name = substr(name, 1, 256)
      for (i = 1; i <= phone_count; i++) {
        if (name == "") continue
        if (emitted >= max) exit
        print phones[i] "\t" name
        emitted++
      }
      delete phones
    }
  ' | jq -Rsc '
    split("\n")
    | map(select(length > 0) | split("\t") | {number: .[0], name: .[1]})
    | unique_by(.number)
    | sort_by(.name | ascii_downcase)
  ' || true
}

contacts() {
  local device_id="${1:-}"
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ ]] || usage
  contact_records_json "$device_id"
}

active_conversations_raw() {
  dbus_bounded 10s busctl --user --json=short call -- "$kdeconnect_service" "$1" \
    org.kde.kdeconnect.device.conversations activeConversations
}

conversations() {
  local device_id="${1:-}" device_path contacts_file raw prev attempt count requested=0 settled=0
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ ]] || usage
  device_path="/modules/kdeconnect/devices/$device_id"
  contacts_file="$(mktemp)"
  trap 'rm -f -- "$contacts_file"' EXIT
  trap 'exit 143' TERM HUP
  trap 'exit 130' INT
  contact_records_json "$device_id" >"$contacts_file"

  # kdeconnectd never asks the phone for messages newer than its cache, so a
  # text sent on the phone stays invisible until the phone happens to push
  # it. Ask the phone to resend every thread's newest message on every
  # listing. Until the phone reconnects to a freshly started daemon the
  # conversations interface is missing entirely; wait for the interface,
  # request once it is there, and return when the thread list has settled.
  raw="$(active_conversations_raw "$device_path" 2>/dev/null || true)"
  for attempt in $(seq 1 20); do
    if [[ -n $raw && $requested == 0 ]]; then
      timeout --kill-after=1s 10s busctl --user call -- "$kdeconnect_service" "$device_path" \
        org.kde.kdeconnect.device.conversations requestAllConversationThreads \
        >/dev/null 2>&1 || true
      requested=1
    fi
    sleep 0.5
    prev="$raw"
    raw="$(active_conversations_raw "$device_path" 2>/dev/null || true)"
    if (( requested == 1 )) && [[ -n $raw ]]; then
      count="$(jq '.data[0] | length' <<<"$raw")"
      if (( count > 0 )) && [[ $raw == "$prev" ]]; then
        settled=$((settled + 1))
      else
        settled=0
      fi
      (( settled >= 3 )) && break
    fi
  done
  if [[ -z $raw ]]; then
    echo "The phone connection is not ready yet" >&2
    exit 1
  fi
  jq -c --slurpfile contactsFile "$contacts_file" '
    $contactsFile[0] as $contacts |
    def number_key:
      gsub("[^0-9]"; "") | if length > 10 then .[-10:] else . end;
    ($contacts | reduce .[] as $contact ({};
      .[($contact.number | number_key)] = $contact.name)) as $contactNames
    |
    def display_name:
      . as $address | ($address | number_key) as $key | $contactNames[$key] // $address;
    [.data[0][]? | .data as $message | {
      threadId: $message[6],
      preview: (($message[1] // "") | tostring | .[0:$previewMax]),
      addresses: ([$message[2][0:20][]?[0] | tostring | .[0:128]] | unique),
      names: ([$message[2][0:20][]?[0] | tostring | .[0:128] | display_name] | unique),
      timestamp: $message[3],
      unread: ($message[5] == 0),
      incoming: ($message[4] == 1),
      attachmentCount: ($message[9] | length),
      attachments: [$message[9][]? | {
        partId: .[0], mimeType: ((.[1] // "") | tostring | .[0:128]),
        thumbnail: (if ((.[2] // "") | tostring | length) <= $thumbMax then (.[2] // "") else "" end),
        unique: (if ((.[3] // "") | type == "string" and length <= 256) then .[3] else "" end)
      }][0:$attachmentsMax]
    }]
    | sort_by(.timestamp)
    | reverse
    | .[0:$threadsMax]
  ' --argjson threadsMax "$threads_max" --argjson thumbMax "$thumbnail_max_chars" \
    --argjson attachmentsMax "$attachments_per_message" --argjson previewMax "$preview_max_chars" <<<"$raw"
  exit 0
}

messages() {
  local device_id="${1:-}" thread_id="${2:-}" device_path capture_dir="" capture_file=""
  local monitor_pid="" request_pid="" reader_pid=""
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ && $thread_id =~ ^[0-9]{1,18}$ ]] || usage
  device_path="/modules/kdeconnect/devices/$device_id"
  start_capture 12s requestConversation xii "$thread_id" 0 200 || exit 1
  stop_capture
  capture_ok || exit 1

  jq -sc --argjson threadId "$thread_id" --arg path "$device_path" '
    [.[]
      | select(.type == "signal" and .path == $path
          and .interface == "org.kde.kdeconnect.device.conversations"
          and .member == "conversationUpdated")
      | .payload.data[0].data
      | select(.[6] == $threadId)
      | {
          body: ((.[1] // "") | tostring | .[0:$bodyMax]),
          timestamp: .[3],
          incoming: (.[4] == 1),
          attachmentCount: (.[9] | length),
          attachments: [.[9][]? | {
            partId: .[0], mimeType: ((.[1] // "") | tostring | .[0:128]),
            thumbnail: (if ((.[2] // "") | tostring | length) <= $thumbMax then (.[2] // "") else "" end),
            unique: (if ((.[3] // "") | type == "string" and length <= 256) then .[3] else "" end)
          }][0:$attachmentsMax]
        }]
    | unique_by(.timestamp, .body, ([.attachments[].unique] | join("|")))
    | sort_by(.timestamp)
    | .[-$messagesMax:]
  ' --argjson messagesMax "$messages_max" --argjson bodyMax "$body_max_chars" \
    --argjson thumbMax "$thumbnail_max_chars" --argjson attachmentsMax "$attachments_per_message" \
    "$capture_file"
  exit 0
}

attachment() {
  local device_id="${1:-}" part_id="${2:-}" unique="${3:-}" mode="${4:-file}" device_path
  local capture_dir="" capture_file="" monitor_pid="" request_pid="" reader_pid="" path arrived attempt
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ && $part_id =~ ^-?[0-9]{1,18}$ && $unique =~ ^[[:print:]]{1,256}$ && $unique != -* ]] || usage
  [[ $mode == image || $mode == file ]] || usage
  device_path="/modules/kdeconnect/devices/$device_id"
  start_capture 30s requestAttachmentFile xs "$part_id" "$unique" || exit 1

  path=""
  for ((attempt=0; attempt<60; attempt++)); do
    capture_ok || exit 1
    path="$( { jq -r --arg unique "$unique" --arg path "$device_path" '
      select(.type == "signal" and .path == $path
          and .interface == "org.kde.kdeconnect.device.conversations"
          and .member == "attachmentReceived")
      | select(.payload.data[1] == $unique)
      | .payload.data[0]
    ' "$capture_file" 2>/dev/null || true; } | head -n 1 )"
    [[ -z $path ]] || break
    sleep 0.5
  done

  stop_capture
  capture_ok || exit 1

  # The phone chose this file and the daemon wrote it, so the path is only used
  # once it resolves to a small file inside KDE Connect's own directories.
  arrived="$path"
  path="$(phone_local_path "$arrived" "$attachment_max_bytes")"
  if [[ -z $path ]]; then
    if [[ -n $arrived ]]; then
      echo "Attachment is not a file OmaLink can open safely" >&2
    else
      echo "Attachment did not arrive from the phone" >&2
    fi
    exit 1
  fi
  # The panel asks for image mode when the phone called the attachment an image,
  # so what reaches Qt's image loader is a raster file rather than whatever the
  # phone chose to send under that name.
  if [[ $mode == image ]]; then
    path="$(phone_file "$path" "$album_art_max_bytes")"
    [[ -n $path ]] && raster_image "$path" || {
      echo "Attachment is not the image the phone said it was" >&2
      exit 1
    }
  fi
  printf '%s\n' "$path"
  exit 0
}

attachment_save() {
  local source="${1:-}" downloads base name ext target n kind
  source="$(phone_local_path "$source" "$attachment_max_bytes")"
  [[ -n $source ]] || usage
  # Saving a file the phone made runnable only moves the problem into the
  # Downloads folder, where a later click runs it. A page is safe to keep, so
  # only opening it is refused.
  kind="$(attachment_content_kind "$source")"
  case $kind in
    other | "web page") ;;
    *)
      echo "OmaLink will not save this attachment from the phone ($kind)" >&2
      exit 1
      ;;
  esac
  downloads="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"
  [[ -n $downloads && $downloads != "${HOME:-}" ]] || downloads="${HOME:-}/Downloads"
  mkdir -p "$downloads"
  base="$(basename "$source")"
  target="$downloads/$base"
  n=1
  # -L as well as -e: a dangling symlink is a name that already exists, and cp
  # would otherwise write through it.
  while ! (set -o noclobber; : >"$target") 2>/dev/null; do
    [[ -e $target || -L $target ]] || { echo "Cannot save in Downloads" >&2; return 1; }
    name="${base%.*}"
    ext="${base##*.}"
    if [[ -z $name || $name == "$base" ]]; then
      target="$downloads/$base-$n"
    else
      target="$downloads/$name-$n.$ext"
    fi
    n=$((n + 1))
  done
  if ! cat -- "$source" >"$target"; then rm -f -- "$target"; return 1; fi
  printf '%s\n' "$target"
}

# KDE Connect keeps the phone's file name, so opening an attachment means
# handing a phone-chosen file to the desktop default application. That is what
# the user asked for by clicking it, but a program is not: files that would run
# are refused, and anything else goes to the user's own handler.
# The handler for a file is chosen from its mime type, so the mime type is what
# decides whether opening it is safe. shared-mime-info is forgiving about case,
# leading whitespace and a byte order mark, and the phone chooses all three, so
# this is asked first and the content scan below is normalized to match.
attachment_mime_kind() {
  local path="$1" mime
  command -v xdg-mime >/dev/null 2>&1 || { printf 'unknown type'; return 0; }
  mime="$(timeout --kill-after=1s 5s xdg-mime query filetype "$path" 2>/dev/null)" || { printf 'unknown type'; return 0; }
  [[ -n $mime ]] || { printf 'unknown type'; return 0; }
  # xdg-open strips the parameters before choosing a handler, so a value like
  # "text/html; charset=utf-8" must not slip past the exact match below.
  mime="${mime%%;*}"
  case ${mime,,} in
    text/html | application/xhtml+xml | image/svg+xml)
      printf 'web page'
      ;;
    application/x-desktop | application/x-executable | application/x-sharedlib | application/x-shellscript | application/x-ms-dos-executable | application/x-msdownload | application/vnd.microsoft.portable-executable | application/x-java-archive | application/vnd.debian.binary-package | application/x-rpm)
      printf 'program'
      ;;
    *) return 1 ;;
  esac
}

attachment_content_kind() {
  local path="$1" magic name text kind
  if [[ -x $path ]]; then printf 'program'; return 0; fi
  name="${path##*/}"
  case ${name,,} in
    *.desktop | *.lnk | *.scr | *.appimage | *.exe | *.msi | *.bat | *.cmd | *.ps1 | *.sh | *.bash | *.zsh | *.py | *.pl | *.rb | *.cgi | *.php | *.asp | *.aspx | *.jsp | *.jar | *.deb | *.rpm)
      printf 'program'
      return 0
      ;;
    # A page or a shortcut opens in the browser and fetches whatever the phone
    # put in it, which is a request the user did not ask for.
    *.html | *.htm | *.xhtml | *.shtml | *.xht | *.svg | *.svgz | *.mhtml | *.mht | *.url | *.webloc)
      printf 'web page'
      return 0
      ;;
  esac
  if kind="$(attachment_mime_kind "$path")"; then
    printf '%s' "$kind"
    return 0
  fi
  magic="$(head -c 16 -- "$path" 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  # Nothing readable to judge by: refuse rather than hand it to the desktop.
  [[ -n $magic ]] || {
    printf 'unreadable file'
    return 0
  }
  case $magic in
    7f454c46* | 4d5a* | fecdfaed* | fecdfaef* | cefaedfe* | cafebabe*)  # ELF, PE, Mach-O, Java
      printf 'program'
      return 0
      ;;
    *) ;;
  esac
  # Text markers are matched after dropping a byte order mark, leading whitespace
  # and case, the three things shared-mime-info forgives.
  text="$(head -c 256 -- "$path" 2>/dev/null | tr -d '\0')"
  text="${text#$'\xef\xbb\xbf'}"
  text="${text#"${text%%[![:space:]]*}"}"
  case ${text,,} in
    '<!doctype html'* | '<html'* | '<svg'*) printf 'web page'; return 0 ;;
    '[desktop entry]'*) printf 'desktop entry'; return 0 ;;
    '#!'*) printf 'script'; return 0 ;;
  esac
  printf 'other'
}

open_attachment() {
  local path="${1:-}" kind
  path="$(phone_local_path "$path" "$attachment_max_bytes")"
  [[ -n $path ]] || usage
  kind="$(attachment_content_kind "$path")"
  if [[ $kind != other ]]; then
    echo "OmaLink will not open this attachment from the phone ($kind)" >&2
    exit 1
  fi
  command -v xdg-open >/dev/null 2>&1 || {
    echo "xdg-open is required" >&2
    exit 1
  }
  # Detached: the default application outlives this helper, and the panel must
  # not wait for it to close.
  setsid xdg-open "$path" >/dev/null 2>&1 </dev/null &
  disown 2>/dev/null || true
}

# KDE Connect has no way to mark a conversation read on the phone, so OmaLink
# keeps its own "seen" state: threadId -> last seen message timestamp. A
# conversation counts as unread only while the phone flags it unread AND its
# latest message is newer than the seen timestamp. Only ids and timestamps are
# stored, never message content.
seen_file() {
  printf '%s/omalink/seen-%s.json' "${XDG_STATE_HOME:-${HOME:-}/.local/state}" "$1"
}

seen() {
  local device_id="${1:-}" file
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ ]] || usage
  file="$(seen_file "$device_id")"
  if [[ -f $file ]] && jq -e 'type == "object"' "$file" >/dev/null 2>&1; then
    jq -c '.' "$file"
  else
    printf '{}\n'
  fi
}

mark_seen() {
  local device_id="${1:-}" file updates="{}" current temp
  [[ $device_id =~ ^[A-Za-z0-9]{1,128}$ ]] || usage
  shift
  (( $# >= 2 && $# % 2 == 0 )) || usage
  while (( $# >= 2 )); do
    [[ $1 =~ ^[0-9]+$ && $2 =~ ^[0-9]+$ ]] || usage
    updates="$(jq -c --arg id "$1" --argjson ts "$2" '.[$id] = $ts' <<<"$updates")"
    shift 2
  done
  file="$(seen_file "$device_id")"
  mkdir -p "$(dirname "$file")"
  (
    flock 9
    current="$(seen "$device_id")"
    temp="$(mktemp "${file}.XXXXXX")"
    trap 'rm -f -- "$temp"' EXIT
    jq -cn --argjson current "$current" --argjson updates "$updates" \
      '$updates | to_entries | reduce .[] as $entry ($current; .[$entry.key] = ([.[$entry.key] // 0, $entry.value] | max))' >"$temp"
    mv -- "$temp" "$file"
  ) 9>"$file.lock"
}

NOTIFY_APPS_SET=""
NOTIFY_APPS=""
NOTIFY_RULES_SET=""
NOTIFY_RULES=""
NOTIFY_POPUPS="on"
while (( $# > 0 )); do
  case $1 in
    --notify-apps) (( $# >= 2 )) || usage; NOTIFY_APPS_SET=1; NOTIFY_APPS="$2"; shift 2 ;;
    --notify-rules) (( $# >= 2 )) || usage; NOTIFY_RULES_SET=1; NOTIFY_RULES="$2"; shift 2 ;;
    --popups) (( $# >= 2 )) || usage; NOTIFY_POPUPS="$2"; shift 2 ;;
    --) shift; break ;;
    -*) usage ;;
    *) break ;;
  esac
done
[[ $NOTIFY_POPUPS == on || $NOTIFY_POPUPS == off ]] || usage

# Per-call timeouts also need an overall deadline: a dead daemon must not
# multiply a five-second wait by every field of every notification.
if [[ ${OMALINK_TIMED:-} != 1 ]]; then
  case "${1:-}" in
    status | diagnostics | conversations | dismiss-all)
      export OMALINK_TIMED=1
      exec timeout --kill-after=2s 45s "$0" "${original_args[@]}"
      ;;
  esac
fi
load_notify_rules

case "${1:-}" in
  status) status ;;
  diagnostics) status true ;;
  watch) watch ;;
  _posted) shift; handle_posted "${1:-}" "${2:-}" ;;
  media) shift; media "${1:-}" ;;
  media-action) shift; media_action "${1:-}" "${2:-}" ;;
  media-volume) shift; media_volume "${1:-}" "${2:-}" ;;
  media-seek) shift; media_seek "${1:-}" "${2:-}" ;;
  ring) shift; ring "${1:-}" ;;
  clipboard) shift; send_clipboard "${1:-}" ;;
  text-stdin)
    (( $# == 1 )) || usage
    exec /usr/bin/python3 "$(dirname -- "$(readlink -f -- "$0")")/omalink-text"
    ;;
  share | sms | reply | notify-reply)
    echo "Text arguments are no longer supported; use text-stdin with a JSON request" >&2
    exit 2
    ;;
  dismiss) shift; dismiss_notification "${1:-}" "${2:-}" ;;
  dismiss-all) shift; dismiss_all_notifications "${1:-}" ;;
  contacts) shift; contacts "${1:-}" ;;
  conversations) shift; conversations "${1:-}" ;;
  messages) shift; messages "${1:-}" "${2:-}" ;;
  attachment) shift; attachment "${1:-}" "${2:-}" "${3:-}" "${4:-}" ;;
  attachment-open) shift; open_attachment "${1:-}" ;;
  attachment-save) shift; attachment_save "${1:-}" ;;
  seen) seen "${2:-}" ;;
  mark-seen) shift; mark_seen "$@" ;;
  *) usage ;;
esac
