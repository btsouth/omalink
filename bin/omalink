#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: omalink [--notify-apps \"App, Package\"] [--popups on|off] <status|watch|media|media-action|media-volume|media-seek|ring|clipboard|share|dismiss|dismiss-all|notify-reply|contacts|conversations|messages|attachment|attachment-open|attachment-save|reply|sms|seen|mark-seen> [arguments]" >&2
  exit 2
}

# --- Phone-supplied data ----------------------------------------------------
# Everything KDE Connect reports comes from the paired phone, so none of it is
# trusted here: a phone app picks the album art URL, the notification icon path
# and the attachment contents. A path handed to the shell's image loader has to
# be a local file KDE Connect itself wrote, or that loader would fetch remote
# URLs and decode unbounded images inside the shell process. Every check fails
# closed: art that does not qualify just leaves the placeholder icon.
album_art_max_bytes=$((4 * 1024 * 1024))
icon_max_bytes=$((1 * 1024 * 1024))
attachment_max_bytes=$((64 * 1024 * 1024))
# How much of a phone's notification list is read per refresh. Each notification
# costs several D-Bus reads, and the count is entirely the phone's to choose, so
# an app posting thousands of them must not be able to stall the bar.
notifications_read_max=100
notifications_max=25
# Same idea for the lists the phone fills: the panel and the Messages window are
# scrollable, so only the newest entries are worth carrying into the shell.
threads_max=200
messages_max=200

# The only directories a phone-supplied path may point into: KDE Connect's
# cache directory (album art, downloaded attachments) and its per-user
# notification icon directory.
phone_file_roots() {
  local user="${USER:-$(id -un)}"
  printf '%s\n' \
    "${XDG_CACHE_HOME:-$HOME/.cache}/kdeconnect.daemon" \
    "${TMPDIR:-/tmp}/kdeconnect_$user" \
    "/tmp/kdeconnect_$user"
}

percent_decode() {
  local encoded="$1" decoded="" escape
  while [[ $encoded == *%* ]]; do
    decoded+="${encoded%%\%*}"
    encoded="${encoded#*\%}"
    escape="${encoded:0:2}"
    [[ $escape =~ ^[0-9A-Fa-f]{2}$ ]] || return 1
    # Files KDE Connect writes have plain printable ASCII names. Anything
    # else, including %00, which would truncate the path as it decodes, is
    # not a path this plugin should follow.
    case "${escape,,}" in
      0* | 1* | 7f) return 1 ;;
    esac
    printf -v escape "\\x$escape"
    decoded+="$escape"
    encoded="${encoded:2}"
  done
  printf '%s' "$decoded$encoded"
}

# Canonical path of "$1" when it is a regular file inside one of the KDE
# Connect directories and no larger than "$2" bytes; empty otherwise. Symlinks
# are resolved first, so a link planted inside those directories cannot point
# at something else.
phone_file() {
  local path="$1" limit="$2" real root size
  [[ -n $path && $limit =~ ^[0-9]+$ ]] || return 0
  real="$(readlink -f -- "$path" 2>/dev/null || true)"
  [[ -n $real && -f $real ]] || return 0
  while IFS= read -r root; do
    root="$(readlink -f -- "$root" 2>/dev/null || true)"
    [[ -n $root && $real == "$root"/* ]] || continue
    size="$(stat -c %s -- "$real" 2>/dev/null || printf '0')"
    (( size > 0 && size <= limit )) || return 0
    printf '%s' "$real"
    return 0
  done < <(phone_file_roots)
}

# A phone-supplied path or file:// URL reduced to a local file we accept, or
# empty. Every other scheme (http, https, data, qrc, image://) is dropped.
phone_local_path() {
  local raw="${1:-}" limit="${2:-0}" path
  case $raw in
    "") return 0 ;;
    file://*) path="$(percent_decode "${raw#file://}")" || return 0 ;;
    /*) path="$raw" ;;
    *) return 0 ;;
  esac
  [[ $path == /* ]] || return 0
  phone_file "$path" "$limit"
}

# Phone data is only ever decoded as a small raster image, so a phone-supplied
# SVG or other markup cannot reach the image loader.
raster_image() {
  local magic
  magic="$(head -c 12 -- "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  case $magic in
    89504e470d0a1a0a*) return 0 ;;  # PNG
    ffd8ff*) return 0 ;;            # JPEG
    47494638*) return 0 ;;          # GIF
    424d*) return 0 ;;              # BMP
    52494646*57454250) return 0 ;;  # WebP
  esac
  return 1
}

# file:// URI for album art the panel may load, or empty.
phone_album_art() {
  local path
  path="$(phone_local_path "${1:-}" "$album_art_max_bytes")"
  [[ -n $path ]] || return 0
  raster_image "$path" || return 0
  printf 'file://%s' "${path// /%20}"
}

# Local icon path for a phone notification, or empty.
phone_icon_path() {
  local path
  path="$(phone_local_path "${1:-}" "$icon_max_bytes")"
  [[ -n $path ]] || return 0
  raster_image "$path" || return 0
  printf '%s' "$path"
}

# Every value below arrives as text over D-Bus, so an unexpected one would make
# jq fail and take the whole status down with it. Numbers and booleans fall back
# instead, which shows as a missing reading rather than an empty panel.
numeric_or() {
  local value="${1:-}" fallback="$2"
  [[ $value =~ ^-?[0-9]+$ ]] || value="$fallback"
  printf '%s' "$value"
}

boolean_or() {
  local value="${1:-}" fallback="$2"
  [[ $value == true || $value == false ]] || value="$fallback"
  printf '%s' "$value"
}

status() {
  if ! command -v kdeconnect-cli >/dev/null 2>&1; then
    jq -cn '{ok: true, installed: false, devices: [], statusText: "KDE Connect is not installed"}'
    return
  fi

  local raw line id name device_path charge charging network_strength network_type notifications
  local -a devices=()
  raw="$(kdeconnect-cli --list-available --id-name-only 2>/dev/null || true)"

  while IFS= read -r line; do
    [[ -n $line ]] || continue
    id="${line%% *}"
    name="${line#* }"
    # A device name that contains a line break would otherwise parse as a second
    # device with an id no D-Bus path can use.
    [[ -n $id && $name != "$line" && $id =~ ^[A-Za-z0-9]+$ ]] || continue
    device_path="/modules/kdeconnect/devices/$id"
    charge="$(dbus_property "$device_path/battery" org.kde.kdeconnect.device.battery charge i)"
    charging="$(dbus_property "$device_path/battery" org.kde.kdeconnect.device.battery isCharging b)"
    network_strength="$(dbus_property "$device_path/connectivity_report" org.kde.kdeconnect.device.connectivity_report cellularNetworkStrength i)"
    network_type="$(dbus_property "$device_path/connectivity_report" org.kde.kdeconnect.device.connectivity_report cellularNetworkType s)"
    notifications="$(notification_json "$device_path")"
    media="$(media_json "$device_path")"
    devices+=("$(jq -cn \
      --arg id "$id" \
      --arg name "$name" \
      --argjson charge "$(numeric_or "${charge:-}" null)" \
      --argjson charging "$(boolean_or "${charging:-}" false)" \
      --argjson networkStrength "$(numeric_or "${network_strength:-}" null)" \
      --arg networkType "${network_type:-}" \
      --argjson notifications "${notifications:-[]}" \
      --argjson media "${media:-null}" \
      '{id: $id, name: $name, battery: {charge: $charge, charging: $charging}, connectivity: {strength: $networkStrength, type: $networkType}, notifications: $notifications, media: $media}')")
  done <<<"$raw"

  if (( ${#devices[@]} == 0 )); then
    jq -cn '{ok: true, installed: true, devices: [], statusText: "No phone connected"}'
  else
    printf '%s\n' "${devices[@]}" | jq -sc '
      {ok: true, installed: true, devices: ., statusText:
        (if length == 1 then .[0].name else "\(length) phones connected" end)}'
  fi
}

notification_json() {
  local device_path="$1" notification_root="$1/notifications" raw notification_id notification_path
  local app_name internal_id title text icon_path dismissable reply_id is_conversation
  local -a notifications=()
  local read_count=0 kept_count=0

  raw="$(busctl --user --json=short call org.kde.kdeconnect "$notification_root" \
    org.kde.kdeconnect.device.notifications activeNotifications 2>/dev/null || true)"
  while IFS= read -r notification_id; do
    [[ $read_count -lt $notifications_read_max && $kept_count -lt $notifications_max ]] || break
    read_count=$((read_count + 1))
    [[ $notification_id =~ ^[A-Za-z0-9._:-]+$ ]] || continue
    notification_path="$notification_root/$notification_id"
    app_name="$(dbus_json_property "$notification_path" appName)"
    internal_id="$(dbus_json_property "$notification_path" internalId)"
    notification_allowed "$app_name" "$internal_id" || continue
    kept_count=$((kept_count + 1))
    title="$(dbus_json_property "$notification_path" title)"
    text="$(dbus_json_property "$notification_path" text)"
    icon_path="$(phone_icon_path "$(dbus_json_property "$notification_path" iconPath)")"
    dismissable="$(boolean_or "$(dbus_json_property "$notification_path" dismissable)" false)"
    reply_id="$(dbus_json_property "$notification_path" replyId)"
    is_conversation="$(boolean_or "$(dbus_json_property "$notification_path" isConversation)" false)"
    notifications+=("$(jq -cn \
      --arg id "$notification_id" \
      --arg appName "$app_name" \
      --arg title "$title" \
      --arg text "$text" \
      --arg iconPath "$icon_path" \
      --argjson dismissable "$dismissable" \
      --arg replyId "$reply_id" \
      --argjson isConversation "$is_conversation" \
      '{id: $id, appName: $appName, title: $title, text: $text, iconPath: $iconPath, dismissable: $dismissable, replyId: $replyId, replyable: ($replyId != ""), isConversation: $isConversation}')")
  done < <(jq -r '.data[0][]?' <<<"$raw" 2>/dev/null)

  if (( ${#notifications[@]} == 0 )); then
    printf '%s\n' '[]'
  else
    printf '%s\n' "${notifications[@]}" | jq -sc '.'
  fi
}

notification_allowed() {
  local app_name="${1,,}" internal_id="${2:-}" package_name="" term
  IFS='|' read -r _ package_name _ <<<"$internal_id"
  package_name="${package_name,,}"

  # --notify-apps wins when given, including an empty list (allow everything).
  if [[ -n $NOTIFY_APPS_SET ]]; then
    [[ -z ${NOTIFY_APPS//[[:space:]]/} ]] && return 0
    local -a terms=()
    IFS=',' read -ra terms <<<"$NOTIFY_APPS"
    for term in "${terms[@]}"; do
      term="${term,,}"
      term="${term#"${term%%[![:space:]]*}"}"
      term="${term%"${term##*[![:space:]]}"}"
      [[ -n $term ]] || continue
      [[ $app_name == *"$term"* || $package_name == *"$term"* ]] && return 0
    done
    return 1
  fi

  case "$package_name" in
    com.google.android.apps.messaging|com.samsung.android.messaging|com.android.messaging|com.android.mms|com.azure.authenticator|com.google.android.apps.authenticator2|com.whatsapp)
      return 0
      ;;
  esac

  case "$app_name" in
    messages|google\ messages|samsung\ messages|messaging|authenticator|microsoft\ authenticator|google\ authenticator|whatsapp)
      return 0
      ;;
  esac

  return 1
}

dbus_json_property() {
  local path="$1" property="$2"
  busctl --user --json=short get-property org.kde.kdeconnect "$path" \
    org.kde.kdeconnect.device.notifications.notification "$property" 2>/dev/null \
    | jq -r '.data // empty' 2>/dev/null || true
}

dbus_property() {
  local path="$1" interface="$2" property="$3" signature="$4" raw
  raw="$(busctl --user get-property org.kde.kdeconnect "$path" "$interface" "$property" 2>/dev/null || true)"
  [[ $raw == "$signature "* ]] || return 0
  raw="${raw#* }"
  if [[ $signature == s ]]; then
    jq -r '.' <<<"$raw" 2>/dev/null || true
  else
    printf '%s\n' "$raw"
  fi
}

# The phone's current media state as reported by KDE Connect's mprisremote
# plugin, or null when nothing is playing (or the plugin interface is gone,
# e.g. the phone has not granted media control permissions).
media_json() {
  local device_path="$1" mpris_path="$1/mprisremote" raw player_list
  local player title artist album volume length position is_playing can_seek album_art
  raw="$(busctl --user --json=short get-property org.kde.kdeconnect "$mpris_path" \
    org.kde.kdeconnect.device.mprisremote playerList 2>/dev/null || true)"
  player_list="$(jq -c '.data // []' <<<"$raw" 2>/dev/null || true)"
  if [[ -z $player_list || $player_list == "[]" ]]; then
    printf 'null\n'
    return
  fi
  player="$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote player s)"
  title="$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote title s)"
  artist="$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote artist s)"
  album="$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote album s)"
  volume="$(numeric_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote volume i)" 0)"
  length="$(numeric_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote length i)" 0)"
  position="$(numeric_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote position i)" 0)"
  is_playing="$(boolean_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote isPlaying b)" false)"
  can_seek="$(boolean_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote canSeek b)" false)"
  album_art="$(phone_album_art "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote localAlbumArtUrl s)")"
  jq -cn \
    --arg player "$player" \
    --arg title "$title" \
    --arg artist "$artist" \
    --arg album "$album" \
    --argjson volume "$volume" \
    --argjson length "$length" \
    --argjson position "$position" \
    --argjson isPlaying "$is_playing" \
    --argjson canSeek "$can_seek" \
    --arg albumArt "${album_art:-}" \
    --argjson players "$player_list" \
    '{player: $player, title: $title, artist: $artist, album: $album,
      volume: $volume, length: $length,
      position: (if $position < 0 then 0 else $position end),
      isPlaying: $isPlaying, canSeek: $canSeek, albumArt: $albumArt, players: $players}'
}

ring() {
  local device_id="${1:-}"
  [[ -n $device_id ]] || usage
  command -v kdeconnect-cli >/dev/null 2>&1 || {
    echo "KDE Connect is not installed" >&2
    exit 1
  }
  kdeconnect-cli --device "$device_id" --ring
}

send_clipboard() {
  local device_id="${1:-}"
  [[ -n $device_id ]] || usage
  command -v kdeconnect-cli >/dev/null 2>&1 || {
    echo "KDE Connect is not installed" >&2
    exit 1
  }
  kdeconnect-cli --device "$device_id" --send-clipboard
}

share_text() {
  local device_id="${1:-}" value="${2:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && -n $value ]] || usage
  command -v kdeconnect-cli >/dev/null 2>&1 || {
    echo "KDE Connect is not installed" >&2
    exit 1
  }
  if [[ $value =~ ^https?:// ]]; then
    kdeconnect-cli --device "$device_id" --share "$value"
  else
    kdeconnect-cli --device "$device_id" --share-text "$value"
  fi
}

media() {
  local device_id="${1:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ ]] || usage
  media_json "/modules/kdeconnect/devices/$device_id"
}

# The Android side interprets these standard MPRIS action names. The full set
# is allowed at the CLI boundary; the panel currently sends only PlayPause,
# Previous, and Next.
media_action() {
  local device_id="${1:-}" action="${2:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $action =~ ^(PlayPause|Play|Pause|Next|Previous|Stop|Rewind|FastForward)$ ]] || usage
  busctl --user call org.kde.kdeconnect "/modules/kdeconnect/devices/$device_id/mprisremote" \
    org.kde.kdeconnect.device.mprisremote sendAction s "$action" >/dev/null
}

media_volume() {
  local device_id="${1:-}" volume="${2:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $volume =~ ^[0-9]+$ && $volume -ge 0 && $volume -le 100 ]] || usage
  busctl --user call org.kde.kdeconnect "/modules/kdeconnect/devices/$device_id/mprisremote" \
    org.freedesktop.DBus.Properties Set ssv \
    org.kde.kdeconnect.device.mprisremote volume i "$volume" >/dev/null
}

# Seek to an absolute position (milliseconds). The plugin only exposes a
# relative seek, so the offset is computed from the live position here.
media_seek() {
  local device_id="${1:-}" target="${2:-}" mpris_path position offset
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $target =~ ^[0-9]+$ ]] || usage
  mpris_path="/modules/kdeconnect/devices/$device_id/mprisremote"
  [[ $(media_json "$mpris_path") != null ]] || {
    echo "No media is playing on the phone" >&2
    exit 1
  }
  position="$(numeric_or "$(dbus_property "$mpris_path" org.kde.kdeconnect.device.mprisremote position i)" "")"
  [[ -n $position ]] || {
    echo "No media is playing on the phone" >&2
    exit 1
  }
  offset=$((target - position))
  busctl --user call org.kde.kdeconnect "$mpris_path" \
    org.kde.kdeconnect.device.mprisremote seek i "$offset" >/dev/null
}

dismiss_notification() {
  local device_id="${1:-}" notification_id="${2:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $notification_id =~ ^[A-Za-z0-9._:-]+$ ]] || usage
  busctl --user call org.kde.kdeconnect \
    "/modules/kdeconnect/devices/$device_id/notifications/$notification_id" \
    org.kde.kdeconnect.device.notifications.notification dismiss >/dev/null
}

# KDE Connect's own desktop popups for phone notifications carry no default
# action, so clicking them in the Omarchy notification popup does nothing.
# OmaLink silences that one event and emits its own popups instead, with a
# click action that opens the OmaLink panel. Message contents are never shown
# in popups; they are readable in the panel and Messages window.
ensure_quiet_daemon_popups() {
  local config="${XDG_CONFIG_HOME:-$HOME/.config}/kdeconnect.notifyrc"
  mkdir -p "$(dirname "$config")"
  if [[ -e $config ]]; then
    grep -q '^\[Event/notification\]' "$config" \
      || printf '\n[Event/notification]\nAction=\n' >>"$config"
    return 0
  fi
  printf '# Written by OmaLink: it shows its own phone notification popups.\n[Event/notification]\nAction=\n' >"$config"
}

# Phone text reaches a popup, and notification daemons render both the summary
# and the body as markup, so it is escaped first. sed does the escaping because
# bash 5.2 and newer read & in a ${value//pattern/replacement} replacement as
# the matched text, which silently swallowed the ampersands here.
notify_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

handle_posted() {
  local device_id="$1" notification_id="$2" notification_path app_name internal_id title text is_conversation icon_path silent summary body action
  local -a icon_args=()
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $notification_id =~ ^[A-Za-z0-9._:-]+$ ]] || return 0
  sleep 0.3
  notification_path="/modules/kdeconnect/devices/$device_id/notifications/$notification_id"
  # On reconnect the phone re-sends every notification still in its shade and
  # the daemon re-posts each one flagged silent. Only new ones get a popup.
  silent="$(dbus_json_property "$notification_path" silent)"
  [[ $silent == true ]] && return 0
  [[ $NOTIFY_POPUPS == off ]] && return 0
  app_name="$(dbus_json_property "$notification_path" appName)"
  internal_id="$(dbus_json_property "$notification_path" internalId)"
  notification_allowed "$app_name" "$internal_id" || return 0
  title="$(dbus_json_property "$notification_path" title)"
  text="$(dbus_json_property "$notification_path" text)"
  is_conversation="$(dbus_json_property "$notification_path" isConversation)"
  icon_path="$(phone_icon_path "$(dbus_json_property "$notification_path" iconPath)")"
  # A notification dismissed between the signal and this read has no fields
  # left, and a popup with an empty title is worse than none.
  if [[ -z $title && -z $text && -z $app_name ]]; then
    return 0
  fi
  if [[ $is_conversation == true ]]; then
    summary="New message"
    body="Open OmaLink to read it"
  else
    # The notification daemon renders both fields as markup, so phone text is
    # escaped before it becomes a popup.
    summary="$(notify_escape "${title:-${app_name:-Phone notification}}")"
    body="$(notify_escape "$text")"
  fi
  if [[ -n $icon_path ]]; then
    icon_args=(-i "$icon_path")
  fi
  action="$(timeout 300 notify-send -a OmaLink "${icon_args[@]}" \
    -A "default=Open" -- "$summary" "$body" 2>/dev/null || true)"
  if [[ $action == default ]]; then
    open_panel || true
  fi
}

# Open the OmaLink panel on the focused monitor. Panels register one IPC
# target per screen ("omalink.phone.<output>"); fall back to the plain target
# (single-bar setups) and then to any registered omalink target. A missing
# target prints "Target not found." with exit 0, so success is empty output.
open_panel() {
  local shell_dir="${OMARCHY_PATH:-/usr/share/omarchy}/shell" focused target result
  local -a targets=("omalink.phone")
  focused="$(hyprctl -j monitors 2>/dev/null \
    | jq -r '[.[] | select(.focused == true) | .name][0] // empty' 2>/dev/null || true)"
  # A monitor name with a space in it used to split into two arguments here.
  if [[ -n $focused ]]; then
    targets=("omalink.phone.$focused" "${targets[@]}")
  fi
  for target in "${targets[@]}"; do
    result="$(qs -p "$shell_dir" ipc call "$target" open 2>&1 || true)"
    [[ -n $result ]] || return 0
  done
  while IFS= read -r target; do
    result="$(qs -p "$shell_dir" ipc call "$target" open 2>&1 || true)"
    [[ -n $result ]] || return 0
  done < <(qs -p "$shell_dir" ipc show 2>/dev/null | sed -n 's/^target \(omalink\.phone[^ ]*\).*/\1/p')
  return 1
}

watch() {
  command -v dbus-monitor >/dev/null 2>&1 || { echo "dbus-monitor is required" >&2; exit 1; }
  # One watcher only, even with a Service instance per bar: the first holds
  # the lock, the rest block here as standbys and take over if it dies. Child
  # processes must not inherit the lock fd (9>&-) or a stray would keep it.
  local runtime="${XDG_RUNTIME_DIR:-/tmp}"
  local pid_file="$runtime/omalink-watch.pid" stale
  exec 9>"$runtime/omalink-watch.lock"
  flock 9
  # Holding the lock means no other watcher is alive, so a pid left in the file
  # belongs to a dbus-monitor orphaned by a killed watcher (the shell kills the
  # watcher on reload but cannot reach this grandchild). Reap that one pid, and
  # only when it is still a dbus-monitor, so an unrelated process cannot be hit.
  if [[ -s $pid_file ]]; then
    stale="$(<"$pid_file")"
    if [[ $stale =~ ^[0-9]+$ ]] && grep -qa 'dbus-monitor' "/proc/$stale/cmdline" 2>/dev/null; then
      kill "$stale" 2>/dev/null || true
    fi
    rm -f "$pid_file"
  fi
  ensure_quiet_daemon_popups || true
  local line device_id="" notification_id
  while IFS= read -r line; do
    case $line in
      *"member=notificationPosted"*)
        device_id="${line#*path=/modules/kdeconnect/devices/}"
        device_id="${device_id%%/*}"
        ;;
      *'string "'*)
        [[ -n $device_id ]] || continue
        notification_id="${line#*string \"}"
        notification_id="${notification_id%\"*}"
        handle_posted "$device_id" "$notification_id" 9>&- &
        printf 'posted %s %s\n' "$device_id" "$notification_id"
        device_id=""
        ;;
    esac
  done < <(dbus-monitor --session \
    "type='signal',interface='org.kde.kdeconnect.device.notifications',member='notificationPosted'" \
    2>/dev/null 9>&- &
    printf '%s\n' "$!" >"$pid_file"
    wait)
  wait
}

notify_reply() {
  local device_id="${1:-}" reply_id="${2:-}" message="${3:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $reply_id =~ ^[A-Za-z0-9._:-]+$ && -n $message ]] || usage
  busctl --user call org.kde.kdeconnect \
    "/modules/kdeconnect/devices/$device_id/notifications" \
    org.kde.kdeconnect.device.notifications sendReply ss "$reply_id" "$message" >/dev/null
}

dismiss_all_notifications() {
  local device_id="${1:-}" notification_root raw notification_id notification_path app_name internal_id
  [[ $device_id =~ ^[A-Za-z0-9]+$ ]] || usage
  notification_root="/modules/kdeconnect/devices/$device_id/notifications"
  raw="$(busctl --user --json=short call org.kde.kdeconnect "$notification_root" \
    org.kde.kdeconnect.device.notifications activeNotifications 2>/dev/null || true)"
  while IFS= read -r notification_id; do
    [[ $notification_id =~ ^[A-Za-z0-9._:-]+$ ]] || continue
    notification_path="$notification_root/$notification_id"
    app_name="$(dbus_json_property "$notification_path" appName)"
    internal_id="$(dbus_json_property "$notification_path" internalId)"
    notification_allowed "$app_name" "$internal_id" || continue
    busctl --user call org.kde.kdeconnect "$notification_path" \
      org.kde.kdeconnect.device.notifications.notification dismiss >/dev/null 2>&1 || true
  done < <(jq -r '.data[0][]?' <<<"$raw" 2>/dev/null)
}

contact_records_json() {
  local device_id="$1" device_path contact_dir
  device_path="/modules/kdeconnect/devices/$device_id"
  contact_dir="${XDG_DATA_HOME:-$HOME/.local/share}/kpeoplevcard/kdeconnect-$device_id"

  busctl --user call org.kde.kdeconnect "$device_path/contacts" \
    org.kde.kdeconnect.device.contacts synchronizeRemoteWithLocal >/dev/null 2>&1 || true

  if ! compgen -G "$contact_dir/*.vcf" >/dev/null; then
    printf '%s\n' '[]'
    return
  fi

  awk '
    function value() { return substr($0, index($0, ":") + 1) }
    /^BEGIN:VCARD/ { name = ""; phone_count = 0 }
    /^FN[;:]/ { name = value(); gsub(/\\,/, ",", name); gsub(/\\;/, ";", name) }
    /^TEL[;:]/ { phones[++phone_count] = value() }
    /^END:VCARD/ {
      gsub(/[\t\r\n]/, " ", name)
      for (i = 1; i <= phone_count; i++) if (name != "") print phones[i] "\t" name
      delete phones
    }
  ' "$contact_dir"/*.vcf | jq -Rsc '
    split("\n")
    | map(select(length > 0) | split("\t") | {number: .[0], name: .[1]})
    | unique_by(.number)
    | sort_by(.name | ascii_downcase)
  '
}

contacts() {
  local device_id="${1:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ ]] || usage
  contact_records_json "$device_id"
}

active_conversations_raw() {
  busctl --user --json=short call org.kde.kdeconnect "$1" \
    org.kde.kdeconnect.device.conversations activeConversations
}

conversations() {
  local device_id="${1:-}" device_path contacts raw prev attempt count requested=0 settled=0
  [[ $device_id =~ ^[A-Za-z0-9]+$ ]] || usage
  device_path="/modules/kdeconnect/devices/$device_id"
  contacts="$(contact_records_json "$device_id")"

  # kdeconnectd never asks the phone for messages newer than its cache, so a
  # text sent on the phone stays invisible until the phone happens to push
  # it. Ask the phone to resend every thread's newest message on every
  # listing. Until the phone reconnects to a freshly started daemon the
  # conversations interface is missing entirely; wait for the interface,
  # request once it is there, and return when the thread list has settled.
  raw="$(active_conversations_raw "$device_path" 2>/dev/null || true)"
  for attempt in $(seq 1 20); do
    if [[ -n $raw && $requested == 0 ]]; then
      busctl --user call org.kde.kdeconnect "$device_path" \
        org.kde.kdeconnect.device.conversations requestAllConversationThreads \
        >/dev/null 2>&1 || true
      requested=1
    fi
    sleep 0.5
    prev="$raw"
    raw="$(active_conversations_raw "$device_path" 2>/dev/null || true)"
    if (( requested == 1 )) && [[ -n $raw ]]; then
      count="$(jq '.data[0] | length' <<<"$raw")"
      if (( count > 0 )) && [[ $raw == "$prev" ]]; then
        settled=$((settled + 1))
      else
        settled=0
      fi
      (( settled >= 3 )) && break
    fi
  done
  if [[ -z $raw ]]; then
    echo "The phone connection is not ready yet" >&2
    exit 1
  fi
  jq -c --argjson contacts "$contacts" '
    def number_key:
      gsub("[^0-9]"; "") | if length > 10 then .[-10:] else . end;
    ($contacts | reduce .[] as $contact ({};
      .[($contact.number | number_key)] = $contact.name)) as $contactNames
    |
    def display_name:
      . as $address | ($address | number_key) as $key | $contactNames[$key] // $address;
    [.data[0][]? | .data as $message | {
      threadId: $message[6],
      preview: $message[1],
      addresses: ([$message[2][]?[0]] | unique),
      names: ([$message[2][]?[0] | display_name] | unique),
      timestamp: $message[3],
      unread: ($message[5] == 0),
      incoming: ($message[4] == 1),
      attachmentCount: ($message[9] | length),
      attachments: [$message[9][]? | {partId: .[0], mimeType: .[1], thumbnail: .[2], unique: .[3]}]
    }]
    | sort_by(.timestamp)
    | reverse
    | .[0:$threadsMax]
  ' --argjson threadsMax "$threads_max" <<<"$raw"
}

messages() {
  local device_id="${1:-}" thread_id="${2:-}" device_path capture_dir capture_file monitor_pid
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $thread_id =~ ^[0-9]+$ ]] || usage
  device_path="/modules/kdeconnect/devices/$device_id"
  capture_dir="$(mktemp -d)"
  capture_file="$capture_dir/signals"
  monitor_pid=""

  cleanup_messages() {
    [[ -z $monitor_pid ]] || kill "$monitor_pid" 2>/dev/null || true
    rm -r "$capture_dir"
  }
  trap cleanup_messages RETURN

  stdbuf -oL busctl --user --verbose --json=short monitor org.kde.kdeconnect >"$capture_file" &
  monitor_pid=$!
  sleep 0.1
  timeout 12s busctl --user call org.kde.kdeconnect "$device_path" \
    org.kde.kdeconnect.device.conversations requestConversation xii "$thread_id" 0 30 >/dev/null \
    || true

  sleep 0.5
  kill "$monitor_pid" 2>/dev/null || true
  wait "$monitor_pid" 2>/dev/null || true
  monitor_pid=""

  jq -sc --argjson threadId "$thread_id" '
    [.[]
      | select(.type == "signal"
          and .interface == "org.kde.kdeconnect.device.conversations"
          and .member == "conversationUpdated")
      | .payload.data[0].data
      | select(.[6] == $threadId)
      | {
          body: .[1],
          timestamp: .[3],
          incoming: (.[4] == 1),
          attachmentCount: (.[9] | length),
          attachments: [.[9][]? | {partId: .[0], mimeType: .[1], thumbnail: .[2], unique: .[3]}]
        }]
    | unique_by(.timestamp, .body, ([.attachments[].unique] | join("|")))
    | sort_by(.timestamp)
    | .[-$messagesMax:]
  ' --argjson messagesMax "$messages_max" "$capture_file"
}

attachment() {
  local device_id="${1:-}" part_id="${2:-}" unique="${3:-}" device_path capture_dir capture_file monitor_pid path arrived attempt
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $part_id =~ ^-?[0-9]+$ && $unique =~ ^[[:print:]]+$ ]] || usage
  device_path="/modules/kdeconnect/devices/$device_id"
  capture_dir="$(mktemp -d)"
  capture_file="$capture_dir/signals"
  monitor_pid=""

  cleanup_attachment() {
    [[ -z $monitor_pid ]] || kill "$monitor_pid" 2>/dev/null || true
    rm -r "$capture_dir"
  }
  trap cleanup_attachment RETURN

  stdbuf -oL busctl --user --json=short monitor org.kde.kdeconnect >"$capture_file" &
  monitor_pid=$!
  sleep 0.1
  busctl --user call org.kde.kdeconnect "$device_path" \
    org.kde.kdeconnect.device.conversations requestAttachmentFile xs "$part_id" "$unique" >/dev/null

  path=""
  for attempt in $(seq 1 60); do
    path="$(jq -r --arg unique "$unique" '
      select(.type == "signal"
          and .interface == "org.kde.kdeconnect.device.conversations"
          and .member == "attachmentReceived")
      | select(.payload.data[1] == $unique)
      | .payload.data[0]
    ' "$capture_file" 2>/dev/null | head -n 1)"
    [[ -z $path ]] || break
    sleep 0.5
  done

  # The phone chose this file and the daemon wrote it, so the path is only used
  # once it resolves to a small file inside KDE Connect's own directories.
  arrived="$path"
  path="$(phone_local_path "$arrived" "$attachment_max_bytes")"
  if [[ -z $path ]]; then
    if [[ -n $arrived ]]; then
      echo "Attachment is not a file OmaLink can open safely" >&2
    else
      echo "Attachment did not arrive from the phone" >&2
    fi
    exit 1
  fi
  printf '%s\n' "$path"
}

attachment_save() {
  local source="${1:-}" downloads base name ext target n kind
  source="$(phone_local_path "$source" "$attachment_max_bytes")"
  [[ -n $source ]] || usage
  # Saving a file the phone made runnable only moves the problem into the
  # Downloads folder, where a later click runs it. A page is safe to keep, so
  # only opening it is refused.
  kind="$(attachment_content_kind "$source")"
  case $kind in
    other | "web page") ;;
    *)
      echo "OmaLink will not save this attachment from the phone ($kind)" >&2
      exit 1
      ;;
  esac
  downloads="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"
  [[ -n $downloads && $downloads != "$HOME" ]] || downloads="$HOME/Downloads"
  mkdir -p "$downloads"
  base="$(basename "$source")"
  target="$downloads/$base"
  n=1
  while [[ -e $target ]]; do
    name="${base%.*}"
    ext="${base##*.}"
    if [[ -z $name || $name == "$base" ]]; then
      target="$downloads/$base-$n"
    else
      target="$downloads/$name-$n.$ext"
    fi
    n=$((n + 1))
  done
  cp "$source" "$target"
  printf '%s\n' "$target"
}

# KDE Connect keeps the phone's file name, so opening an attachment means
# handing a phone-chosen file to the desktop default application. That is what
# the user asked for by clicking it, but a program is not: files that would run
# are refused, and anything else goes to the user's own handler.
attachment_content_kind() {
  local path="$1" magic name
  name="${path##*/}"
  case ${name,,} in
    *.desktop | *.lnk | *.scr | *.appimage | *.exe | *.msi | *.bat | *.cmd | *.ps1 | *.sh | *.bash | *.zsh | *.py | *.pl | *.rb | *.jar | *.deb | *.rpm)
      printf 'program'
      return 0
      ;;
    # A page or a shortcut opens in the browser and fetches whatever the phone
    # put in it, which is a request the user did not ask for.
    *.html | *.htm | *.xhtml | *.svg | *.mhtml | *.url | *.webloc)
      printf 'web page'
      return 0
      ;;
  esac
  magic="$(head -c 16 -- "$path" 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  # Nothing readable to judge by: refuse rather than hand it to the desktop.
  [[ -n $magic ]] || {
    printf 'unreadable file'
    return 0
  }
  case $magic in
    7f454c46* | 4d5a* | fecdfaed* | fecdfaef* | cefaedfe* | cafebabe*) printf 'program' ;;  # ELF, PE, Mach-O, Java
    2321*) printf 'script' ;;                                                               # #!
    5b4465736b746f7020456e7472795d*) printf 'desktop entry' ;;                             # [Desktop Entry]
    3c21444f4354595045* | 3c68746d6c* | 3c737667*) printf 'web page' ;;                    # <!DOCTYPE, <html, <svg
    *) printf 'other' ;;
  esac
}

open_attachment() {
  local path="${1:-}" kind
  path="$(phone_local_path "$path" "$attachment_max_bytes")"
  [[ -n $path ]] || usage
  kind="$(attachment_content_kind "$path")"
  if [[ $kind != other ]]; then
    echo "OmaLink will not open this attachment from the phone ($kind)" >&2
    exit 1
  fi
  command -v xdg-open >/dev/null 2>&1 || {
    echo "xdg-open is required" >&2
    exit 1
  }
  # Detached: the default application outlives this helper, and the panel must
  # not wait for it to close.
  setsid xdg-open "$path" >/dev/null 2>&1 </dev/null &
  disown 2>/dev/null || true
}

reply() {
  local device_id="${1:-}" thread_id="${2:-}" message="${3:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $thread_id =~ ^[0-9]+$ && -n $message ]] || usage
  busctl --user call org.kde.kdeconnect \
    "/modules/kdeconnect/devices/$device_id" \
    org.kde.kdeconnect.device.conversations replyToConversation \
    xsav "$thread_id" "$message" 0 >/dev/null
}

# KDE Connect has no way to mark a conversation read on the phone, so OmaLink
# keeps its own "seen" state: threadId -> last seen message timestamp. A
# conversation counts as unread only while the phone flags it unread AND its
# latest message is newer than the seen timestamp. Only ids and timestamps are
# stored, never message content.
seen_file() {
  printf '%s/omalink/seen.json' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

seen() {
  local file
  file="$(seen_file)"
  if [[ -f $file ]] && jq -e 'type == "object"' "$file" >/dev/null 2>&1; then
    jq -c '.' "$file"
  else
    printf '{}\n'
  fi
}

mark_seen() {
  local file updates="{}" current
  (( $# >= 2 && $# % 2 == 0 )) || usage
  while (( $# >= 2 )); do
    [[ $1 =~ ^[0-9]+$ && $2 =~ ^[0-9]+$ ]] || usage
    updates="$(jq -c --arg id "$1" --argjson ts "$2" '.[$id] = $ts' <<<"$updates")"
    shift 2
  done
  file="$(seen_file)"
  mkdir -p "$(dirname "$file")"
  (
    flock 9
    current="$(seen)"
    jq -cn --argjson current "$current" --argjson updates "$updates" \
      '$current * $updates' >"$file.tmp"
    mv "$file.tmp" "$file"
  ) 9>"$file.lock"
}

send_sms() {
  local device_id="${1:-}" destination="${2:-}" message="${3:-}" digits
  digits="${destination//[^0-9]/}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $destination =~ ^[+0-9().[:space:]-]+$ && ${#digits} -ge 3 && -n $message ]] || usage
  kdeconnect-cli --device "$device_id" --send-sms "$message" --destination "$destination"
}

NOTIFY_APPS_SET=""
NOTIFY_APPS=""
NOTIFY_POPUPS="on"
omalink_args=()
while (( $# > 0 )); do
  case $1 in
    --notify-apps) NOTIFY_APPS_SET=1; NOTIFY_APPS="${2:-}"; shift 2 ;;
    --popups) NOTIFY_POPUPS="${2:-on}"; shift 2 ;;
    *) omalink_args+=("$1"); shift ;;
  esac
done
set -- "${omalink_args[@]}"

case "${1:-}" in
  status) status ;;
  watch) watch ;;
  media) shift; media "${1:-}" ;;
  media-action) shift; media_action "${1:-}" "${2:-}" ;;
  media-volume) shift; media_volume "${1:-}" "${2:-}" ;;
  media-seek) shift; media_seek "${1:-}" "${2:-}" ;;
  ring) shift; ring "${1:-}" ;;
  clipboard) shift; send_clipboard "${1:-}" ;;
  share) shift; share_text "${1:-}" "${2:-}" ;;
  dismiss) shift; dismiss_notification "${1:-}" "${2:-}" ;;
  dismiss-all) shift; dismiss_all_notifications "${1:-}" ;;
  notify-reply) shift; notify_reply "${1:-}" "${2:-}" "${3:-}" ;;
  contacts) shift; contacts "${1:-}" ;;
  conversations) shift; conversations "${1:-}" ;;
  messages) shift; messages "${1:-}" "${2:-}" ;;
  attachment) shift; attachment "${1:-}" "${2:-}" "${3:-}" ;;
  attachment-open) shift; open_attachment "${1:-}" ;;
  attachment-save) shift; attachment_save "${1:-}" ;;
  reply) shift; reply "${1:-}" "${2:-}" "${3:-}" ;;
  sms) shift; send_sms "${1:-}" "${2:-}" "${3:-}" ;;
  seen) seen ;;
  mark-seen) shift; mark_seen "$@" ;;
  *) usage ;;
esac
